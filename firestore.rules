// do perfil estruturado: isValidProfile exige só data.about is map &&
// data.about.keys().size() <= 30, as chaves de DENTRO do mapa não são
// validadas — deliberado, pra que um campo novo no catálogo do client
// (src/constants/profileAbout.ts) não exija mexer nas rules nem fazer
// deploy; entra no hasOnly do UPDATE apenas, fora do create — conta nova
// nasce sem o campo; molde exato da cláusula de filters logo acima, só
// com teto de chaves a mais) + S97 (users/{userId} update ganha campo paused, bool opcional
// — "pausar perfil"/modo invisível: entra no diff().affectedKeys().hasOnly()
// ao lado de reengagementOptOut; isValidProfile valida SÓ quando presente
// (data.paused is bool); NÃO entra no hasOnly do create — conta nova nasce
// sem o campo, ou seja, despausada por default; é filtro de VISIBILIDADE no
// client (getDiscoverProfiles/useLikers/useMyLikes), não fronteira de
// leitura — rules não ganham guarda nova, o doc continua lido por qualquer
// isSignedIn() como hoje, senão quebraria matches/conversas existentes) +
// S96-A (reports/{reportId} deixa de ser só de ida: allow read
// isAdmin()||reporterId==auth.uid (denunciado nunca lê); create aceita
// status ausente — compat com build antigo do reportUser em campo, que
// ainda não manda o campo — ou 'open', nunca já 'resolved'; allow update
// restrito a isAdmin(), só trocando status entre 'open'/'resolved' via
// diff().affectedKeys().hasOnly(['status']); nova subcoleção
// reports/{reportId}/messages espelhando support/{ticketId}/messages, com
// reporterId no lugar do uid do ticket) + S92+S76-B2 (users/{userId} update: birthDate vira IMUTÁVEL a
// partir da aprovação da verificação, mesmo gatilho get('verified', false)
// != true do nome — 3 ramos: não verificado livre, verificado sem
// birthDate libera a 1ª gravação, verificado com birthDate exige valor
// idêntico; `age` NÃO trava, continua livre pra reconciliar via
// getDisplayAge no save do client) + S76-B1 (users/{userId} update: nome vira IMUTÁVEL a partir da
// aprovação da verificação — resource.data.get('verified', false) != true ||
// request.resource.data.name == resource.data.name, inserido logo após a
// guarda write-once do vale) + S92 (matches/{matchId}/messages/{messageId} ganha segundo ramo de
// update pra editar texto — mesma janela de 1h de createdAt, sem lapide,
// sem foto/localizacao, text editável com truncamento, editedAt obrigatório
// com serverTimestamp) + S85-B (matches/{matchId}/messages/{messageId} ganha update:
// "apagar pros dois" vira lápide, nunca deleta o doc — só o próprio
// senderId, só dentro de 1h de createdAt (duration.value), só uma vez
// (!('deletedAt' in resource.data)), hasOnly(['senderId','createdAt',
// 'deletedAt']) derruba text/imageUrl/location/replyTo por construção,
// senderId e createdAt preservados, deletedAt == request.time; allow delete
// continua false, separado) + S85-A (matches/{matchId}/hidden/{uid} nova: "apagar pra mim",
// doc por usuário com messageIds (list) das mensagens escondidas na própria
// tela — client-side only, não afeta o doc da mensagem nem o outro
// participante; create/update restrito ao dono, hasOnly(['messageIds']);
// delete negado por quebrar hasOnly sobre request.resource nulo; messages/
// {messageId} intocado, allow update, delete: if false segue igual) + S83-A (users/{userId} ganha campo vale, enum ['BB', 'CAIXA',
// 'BRB']: obrigatório no create, dentro do enum; no update, gravável UMA VEZ
// só — campo ausente nos dois é ok, campo já existente não pode mudar de
// valor, campo ausente antes e presente agora precisa estar no enum; entra
// no hasOnly de create e update) + S76-A (birthDate opcional em users/{userId}: entra no hasOnly
// de create e update; isValidProfile valida SÓ quando presente — is
// timestamp e idade aproximada entre 18 e 101 anos via duration.value(),
// checagem exata mora no client; age continua obrigatório e sem trava,
// segue derivado de birthDate no cadastro; nenhum campo removido) + S80-A
// (matches/{matchId}/reactions/{messageId} nova: reação de
// emoji por mensagem, chave = uid de quem reagiu, valor = emoji — mesmo
// padrão de guarda por diff de 3 ramos do typing (S79-C1): chave do próprio
// uid inalterada, ausente no resultado (remoção via deleteField, usada pelo
// S80-B) ou presente com valor na lista fixa de 6 emoji; create+update
// juntos pois o doc pode não existir na 1ª reação, mesmo padrão do presence
// (S79-C2-A); delete negado; lista de emoji precisa ficar em sincronia com
// REACTION_EMOJIS em src/services/firestoreService.ts) + S79-C2-A (presence/{userId} nova, raiz: heartbeat de última vez visto — create/update só do dono com lastSeenAt == request.time (só serverTimestamp) e hasOnly(['lastSeenAt']); read do dono OU de quem tem match com ele, checando as duas ordens de matchId com exists(); delete negado) + S79-C1 (matches/{matchId} update: guarda de tipo pro carimbo de typing — quando a chave typing.{uid} do próprio usuário permanece no resultado, exige timestamp E igual a request.time, mesmo padrão de lastReadAt; remoção da chave (deleteField, ao parar de digitar) continua liberada, sem essa exigência) + S79 (matches/{matchId}/messages ganha replyTo opcional — citacao de mensagem, so texto v1: map com messageId/senderId/text, text.size()<=400 = 4x o limite do client de 100 code points, mesma logica do S77; cap de 2000 do text da mensagem em si, verified e blockedBy continuam intocados) + S77 (contagem de texto: client passa a contar CODE POINTS (Array.from), rules deixam de ser regua de UX e viram guarda de abuso — todo teto de campo de texto livre subiu pra 4x o limite do client: note 150->600, prompt/weeklyPromptAnswer answer 150->600, places 40->160, events 60->240, details da denuncia 500->2000, suporte (ticket+thread) 1000->4000, bio 500->2000, nome 60->240; chat ficou como estava, ja tinha folga) + S75 (users/{uid}/private/registration deixa de ser imutavel: dono pode corrigir o chaveF quando verifications/{uid}.status=='rejected', createdAt preservado, get() cruzado com verifications) + S74 (contador proprio de resposta, users/{uid}/replies/usage, espelhando superLikes/usage; S74-A criou/gravou o contador, S74-B passou a EXIGIR a quota dentro do bloco do note, ramo direction=='like', com o mesmo getAfter/exists/get do superlike) + S73 (bilhete tambem em direction=='like', verified checado dentro do proprio bloco do note so pro caminho like — superlike continua pegando o gate do ramo de baixo) + S70 (super curtida restrita a perfil verificado; verified sai do bloco note e vira 1a condicao do ramo direction=='superlike') + S68 (cap por string em places/events, details da denuncia sem so-espaco) + S67 (bilhete opcional na super curtida, swipes.note) + S59 (prompt da semana em campo proprio weeklyPromptAnswer, fora de prompts[]) + S58 (motivo de rejeicao da verificacao) + S50 (prompt da semana, cap 3→4) + S49 (swipe read null-guard) + S48 (places/events) + S45 (swipe context) + S44 (uf) + S-Matricula (troca "Chave F" pra "Matrícula", regex ^F\d{7}$ pra ^[A-Z]?\d{1,7}$ — F+7 continua casando, sem migração) + S149-B (26/08/2026 — reações no chat de grupo: groups/{groupId}/reactions/{messageId} novo, mirror de matches/{matchId}/reactions [S80-A], mesma lista de 6 emojis, membership via groupAllowsPost em vez de getMatch(matchId).users) — 2026-08-03
// Atualize este carimbo a cada sprint que alterar este arquivo: ele
// força o upload no deploy (evita "skipping upload" silencioso) e
// identifica no console do Firebase qual versão está ativa.
// firestore.rules — última alteração: S104 (2026-08-06)
// Regras de PRODUÇÃO — deny by default: toda collection sem regra explícita é bloqueada
// (ver o "catch-all" no final do arquivo).
//
// Como aplicar (só quando estiver pronto pra testar — ver instruções completas no chat):
//   1) Console: Firebase Console → Firestore Database → Regras → colar este arquivo → Publicar
//   2) CLI: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── Helpers ─────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // S115 — dois uids admin, hardcoded de propósito: Rules não importa
    // src/config/admin.ts, então esta lista precisa ser mantida em sincronia
    // manual com ADMIN_UIDS no app (e com os literais iguais já usados na
    // regra de create de matches/{matchId} e nos 3 literais de storage.rules).
    function isAdmin() {
      return isSignedIn()
        && request.auth.uid in ['Gd0pJi8WjYS60JHOnhIx9R6vktJ3', '358dfiUwFlbFV0Z3KCyvKXwGGxD3'];
    }

    // Evita repetir o texto do get() de matches/{matchId} nas regras abaixo.
    function getMatch(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    // Evita repetir o texto do get() de support/{ticketId} nas regras da
    // subcollection support/{ticketId}/messages (S38).
    function getTicket(ticketId) {
      return get(/databases/$(database)/documents/support/$(ticketId)).data;
    }

    // S143-B — evita repetir o texto do get() de momentoRequests/{requestId}
    // nas regras da subcollection momentoRequests/{requestId}/messages.
    function getMomentoRequest(requestId) {
      return get(/databases/$(database)/documents/momentoRequests/$(requestId)).data;
    }

    // S143-C (revisão pós-teste de aparelho — endurecimento defensivo) —
    // exists() nunca lança erro pra doc ausente (ao contrário de get(), que
    // lança e derruba a rule inteira com permission-denied — a mesma classe
    // de bug do resource == null já corrigida no allow read de
    // momentoRequests/{requestId} abaixo). getMomentoRequest() acima usa
    // get() direto: todo call site dele em messages/{messageId} abaixo
    // PRECISA checar momentoRequestExists(requestId) antes, senão uma
    // tentativa de ler/criar mensagem sob um requestId que não existe (bug
    // de client, id forjado, ou corrida de exclusão) quebra a avaliação em
    // vez de simplesmente negar.
    function momentoRequestExists(requestId) {
      return exists(/databases/$(database)/documents/momentoRequests/$(requestId));
    }

    // Recebe o match já lido (getMatch chamado 1x pelo caller) em vez de
    // chamar getMatch de novo aqui — Rules não tem 'let', então isso é o jeito
    // de checar duas condições sobre o mesmo doc com um único get() faturado.
    function matchAllowsPost(m, uid) {
      return uid in m.users && m.get('blockedBy', []).size() == 0;
    }

    // S124-A — mirror de matchAllowsPost acima, pra groups/{groupId}/messages.
    // Diferença de forma: matchAllowsPost recebe o doc do match JÁ LIDO (m),
    // porque a lista de participantes vive dentro dele (m.users); um grupo
    // não guarda a lista de membros no doc pai (é a subcoleção members/ que
    // guarda), então aqui não há "doc pré-lido" pra receber — o exists()
    // FAZ a leitura. Mesma ideia (uid tem que estar autorizado a postar),
    // mecanismo adaptado ao desenho de dados diferente.
    function groupAllowsPost(groupId, uid) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid));
    }

    // Um item de users/{uid}.prompts[] — { id: string, answer: string }.
    // Ver src/constants/prompts.ts (catálogo) e MAX_ANSWER_LENGTH no app
    // (150). S77 — 600 = 4x MAX_ANSWER_LENGTH: client conta por code point
    // e já barra em 150; este teto aqui não é mais régua de UX, é só guarda
    // de abuso (client malicioso direto contra a API). NÃO é número solto —
    // mexer nele significa mexer em MAX_ANSWER_LENGTH E aqui.
    function isValidPromptItem(item) {
      return item is map && item.keys().hasOnly(['id', 'answer'])
        && item.id is string
        && item.answer is string && item.answer.size() >= 1 && item.answer.size() <= 600
        && item.answer.matches('.*\\S.*');
    }

    // Rules não tem loop — valida cada item individualmente por índice, com
    // curto-circuito no size() (padrão igual ao comentário do S33: só entra
    // no índice N se list.size() > N). Máximo 4 prompts (MAX_PROMPTS no app;
    // S50 — bumped de 3 pra 4 pra caber os 3 prompts normais + 1 "prompt da
    // semana" no mesmo array; decisão a validar na auditoria, ver comentário
    // em src/constants/prompts.ts). Cada ramo também barra id duplicado
    // contra os índices já validados antes dele (list[1] vs list[0]; list[2]
    // vs list[0] e list[1]; list[3] vs list[0], list[1] e list[2]).
    function isValidPrompts(list) {
      return list is list && list.size() <= 4
        && (list.size() == 0
            || (isValidPromptItem(list[0])
                && (list.size() == 1
                    || (isValidPromptItem(list[1])
                        && list[0].id != list[1].id
                        && (list.size() == 2
                            || (isValidPromptItem(list[2])
                                && list[0].id != list[2].id
                                && list[1].id != list[2].id
                                && (list.size() == 3
                                    || (isValidPromptItem(list[3])
                                        && list[0].id != list[3].id
                                        && list[1].id != list[3].id
                                        && list[2].id != list[3].id))))))));
    }

    // S68 — item de places[]/events[]: string de 1..maxLength chars, sem ser
    // só espaço. Mesmo padrão de validação de item de isValidPromptItem
    // acima, só que sem `id` (places/events são texto livre, sem catálogo).
    function isValidTag(value, maxLength) {
      return value is string && value.size() >= 1 && value.size() <= maxLength
        && value.matches('.*\\S.*');
    }

    // S68 — endurecimento: antes desta sprint, isValidProfile só checava
    // `data.places is list && data.places.size() <= 5` — tipo e teto da
    // LISTA, sem validar o conteúdo de cada string (um client malicioso
    // podia gravar item vazio, só espaço, ou maior que o limite que o
    // próprio app já impõe visualmente). Mesmo padrão de isValidPrompts
    // (valida list[0], list[1], ... individualmente, com curto-circuito no
    // size() — só entra no índice N se list.size() > N), sem checagem de
    // duplicata (não faz sentido pra texto livre). S77 — 160 = 4x
    // MAX_PLACE_LENGTH (40) em src/screens/ProfileScreen.tsx: client conta
    // por code point e barra em 40; aqui é só guarda de abuso, não é número
    // solto — mexer nele significa mexer em MAX_PLACE_LENGTH E aqui.
    function isValidPlaces(list) {
      return list is list && list.size() <= 5
        && (list.size() == 0
            || (isValidTag(list[0], 160)
                && (list.size() == 1
                    || (isValidTag(list[1], 160)
                        && (list.size() == 2
                            || (isValidTag(list[2], 160)
                                && (list.size() == 3
                                    || (isValidTag(list[3], 160)
                                        && (list.size() == 4
                                            || isValidTag(list[4], 160))))))))));
    }

    // S68 — idem isValidPlaces acima, aplicado a events[] (teto de 3 itens).
    // S77 — 240 = 4x MAX_EVENT_LENGTH (60) em src/screens/ProfileScreen.tsx,
    // mesmo raciocínio de guarda de abuso do isValidPlaces acima.
    function isValidEvents(list) {
      return list is list && list.size() <= 3
        && (list.size() == 0
            || (isValidTag(list[0], 240)
                && (list.size() == 1
                    || (isValidTag(list[1], 240)
                        && (list.size() == 2
                            || isValidTag(list[2], 240))))));
    }

    // S59 — Prompt da semana ganhou campo próprio (weeklyPromptAnswer),
    // FORA de prompts[]/isValidPrompts acima (que fica intocada: continua
    // size() <= 4, só prompts normais do catálogo p01-p10). Slot único (não é
    // lista) — id restrito ao pool w01-w12 de src/constants/prompts.ts (ao
    // contrário de isValidPromptItem, que aceita qualquer string em item.id,
    // porque prompts[] também tolera ids de catálogo futuro; aqui o pool é
    // fechado, então validamos contra a lista). Mesmo limite de tamanho de
    // resposta de isValidPromptItem — S77: 600 = 4x MAX_ANSWER_LENGTH (150),
    // mesmo raciocínio de guarda de abuso do comentário de isValidPromptItem.
    function isValidWeeklyPromptAnswer(item) {
      return item is map && item.keys().hasOnly(['id', 'answer'])
        && item.id in ['w01', 'w02', 'w03', 'w04', 'w05', 'w06',
                        'w07', 'w08', 'w09', 'w10', 'w11', 'w12']
        && item.answer is string && item.answer.size() >= 1 && item.answer.size() <= 600
        && item.answer.matches('.*\\S.*');
    }

    // Campos que o dono do perfil pode criar/editar. Qualquer campo fora desta
    // lista (ex: um futuro "isAdmin" ou "verified") NUNCA pode ser escrito pelo
    // client, mesmo que alguém adicione o campo no app no futuro e esqueça de
    // atualizar as regras — hasOnly() bloqueia por padrão.
    // S77 — 240 = 4x MAX_NAME_LENGTH (60) e 2000 = 4x MAX_BIO_LENGTH (500),
    // ambos em src/screens/ProfileScreen.tsx: até esta sprint nome/bio não
    // tinham teto nenhum no client (bug separado, ver recon) — 60/500 eram
    // só o que as rules já exigiam. Client agora conta por code point e
    // barra em 60/500; aqui virou guarda de abuso, 4x maior. Não são
    // números soltos — mexer neles significa mexer nas constantes do app
    // E aqui.
    function isValidProfile(data) {
      return data.age is number && data.age >= 18 && data.age <= 100
        // S135 — nickname ("como quer ser chamado") é o novo nome público,
        // e fica SÓ QUANDO PRESENTE aqui, mesmo molde de gender/uf/vale
        // logo abaixo — de propósito NÃO é obrigatório dentro desta função
        // (que roda tanto no create quanto no update): se virasse
        // obrigatório aqui, toda conta EXISTENTE sem nickname ainda
        // (migração é script manual, functions/scripts/migrateNicknames.js,
        // rodado por Raphael depois do deploy — pode haver uma janela sem
        // migração feita) ficaria impedida de salvar qualquer edição de
        // perfil (até uma bio), porque request.resource.data no update é o
        // documento resultante completo e nickname estaria ausente.
        // uf/vale/lookingFor resolvem esse mesmo problema do jeito certo:
        // obrigatórios só no allow create (conta nova), tolerantes aqui no
        // update. name (legado) NÃO é mais validado aqui — sai do doc
        // público a partir desta sprint, migra pra
        // users/{uid}/private/legalName (ver match próprio abaixo).
        && (!('nickname' in data) || (data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 120))
        // S76-A — SÓ quando presente: perfis antigos não têm birthDate, e
        // esta função roda no update também — exigir sempre travaria toda
        // conta legada ao editar bio/foto/etc. 6570d ~ 18 anos e 36890d ~
        // 101 anos, aproximação deliberada (meses/anos bissextos não
        // entram na conta) — a checagem exata mora no client
        // (parseBirthInput, src/utils/birthDate.ts).
        && (!('birthDate' in data) ||
            (data.birthDate is timestamp
             && request.time - data.birthDate > duration.value(6570, 'd')
             && request.time - data.birthDate < duration.value(36890, 'd')))
        && data.bio is string && data.bio.size() <= 2000
        && data.photoURL is string
        && data.photos is list && data.photos.size() <= 4
        && data.interests is list && data.interests.size() <= 15
        && (!('gender' in data) || data.gender in ['masculino', 'feminino', 'outro'])
        && (!('location' in data) || (data.location.lat is number && data.location.lng is number))
        && (!('filters' in data) || data.filters is map)
        // S104 — `about` é o piloto do perfil estruturado: mapa livre, teto
        // de 30 chaves pra conter tamanho de doc. As chaves de DENTRO não
        // são validadas de propósito — permite adicionar campo novo no
        // catálogo (src/constants/profileAbout.ts) sem exigir rules nem
        // deploy. Mesmo padrão de `filters` acima. Só entra no hasOnly do
        // UPDATE (ver allow update abaixo) — conta nova nasce sem o campo.
        && (!('about' in data) || (data.about is map && data.about.keys().size() <= 30))
        // S109 — visibilidade por campo do `about`: array de AboutFieldId
        // (ids escondidos do perfil público), SÓ quando presente — ausente
        // ou vazio = nada escondido (default = tudo visível). Mesmo molde
        // exato da cláusula de `about` logo acima, com is list no lugar de
        // is map (não precisa de teto próprio de tamanho por item — só o
        // teto de 30 entradas, igual about.keys().size()). Não valida que
        // cada item seja de fato um AboutFieldId do catálogo — mesma
        // decisão de about acima: catálogo muda no client, sem deploy.
        && (!('aboutHidden' in data) || (data.aboutHidden is list && data.aboutHidden.size() <= 30))
        && (!('prompts' in data) || isValidPrompts(data.prompts))
        // S59 — slot único do prompt da semana, separado de prompts[] acima.
        && (!('weeklyPromptAnswer' in data) || isValidWeeklyPromptAnswer(data.weeklyPromptAnswer))
        // S48/S68 — "Meus lugares"/"No meu radar": texto livre, opcionais,
        // sem catálogo. S68 endureceu a validação pra item a item (antes só
        // tipo da lista e teto de tamanho, igual `interests` continua sendo
        // hoje — ver achado da sprint) — ver isValidPlaces/isValidEvents.
        && (!('places' in data) || isValidPlaces(data.places))
        && (!('events' in data) || isValidEvents(data.events))
        // S97 — paused (pausar perfil/modo invisível): só quando presente,
        // precisa ser bool. Filtro de VISIBILIDADE no client
        // (getDiscoverProfiles/useLikers/useMyLikes) — não é fronteira de
        // leitura, o doc segue lido por qualquer isSignedIn() como hoje.
        && (!('paused' in data) || data.paused is bool)
        // S126 — Enquete no perfil: mesmo molde condicional de about/
        // aboutHidden acima (ausente = sempre válido). Literais 100/2/5
        // espelham MAX_POLL_QUESTION_LENGTH/MIN_POLL_OPTIONS/MAX_POLL_OPTIONS
        // (src/constants/poll.ts) — Rules não importa src/, sincronize
        // manualmente, mesmo padrão do comentário em
        // src/constants/prompts.ts:64 sobre WEEKLY_PROMPT_EPOCH. Não valida
        // item a item de `options` (cada elemento é string dentro do teto)
        // de propósito — mesmo grau de validação já aceito pra `interests`
        // acima (só is list + size()), sem inventar rigor que o resto do
        // arquivo não tem.
        && (
          !('poll' in data)
          || (
            data.poll is map
            && data.poll.keys().hasOnly(['question', 'options'])
            && data.poll.question is string
            && data.poll.question.size() > 0
            && data.poll.question.size() <= 100
            && data.poll.options is list
            && data.poll.options.size() >= 2
            && data.poll.options.size() <= 5
          )
        );
    }

    // Um match só pode ser criado se as DUAS pessoas já deram like/superlike uma
    // na outra. Recalcula a condição no servidor via get() — nunca confia no
    // client dizer "isMatch: true", porque o client pode mentir.
    function mutualLikeExists(users) {
      return exists(/databases/$(database)/documents/swipes/$(users[0] + '_' + users[1]))
        && exists(/databases/$(database)/documents/swipes/$(users[1] + '_' + users[0]))
        && get(/databases/$(database)/documents/swipes/$(users[0] + '_' + users[1])).data.direction != 'nope'
        && get(/databases/$(database)/documents/swipes/$(users[1] + '_' + users[0])).data.direction != 'nope';
    }

    // ───────────────────────── users ─────────────────────────
    //
    // O token de push mora em users/{uid}/private/push (ver subregra abaixo),
    // não mais em users/{uid}.pushToken — Firestore Rules não faz redação por
    // campo em leitura, então qualquer campo no doc principal fica visível a
    // todo usuário autenticado (allow read abaixo é intencionalmente amplo,
    // para permitir o Swipe/Discover). O envio de push é feito por Cloud
    // Function (Admin SDK, ignora estas regras) — ver functions/src/index.ts.
    match /users/{userId} {
      allow read: if isSignedIn();

      // lookingFor fica FORA de isValidProfile() de propósito, igual uid/
      // createdAt acima: create e update têm exigência diferente pra ele (o
      // único campo obrigatório da lista, os demais são todos opcionais
      // dentro de isValidProfile), então cada allow valida do seu jeito em
      // vez de a função compartilhada ganhar um parâmetro pra isso.
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.createdAt == request.time
        // Obrigatório no cadastro: sem o campo (ou com valor fora da
        // lista), o create inteiro é negado.
        && request.resource.data.lookingFor in
             ['relacionamento_serio', 'casual', 'amizade', 'descobrindo']
        // S44 — mesmo padrão de lookingFor acima: descoberta nacional depende
        // de toda conta nova ter uf, então é obrigatório no cadastro. Sem o
        // campo (ou com sigla fora da lista), o create inteiro é negado.
        && request.resource.data.uf in
             ['AC', 'AL', 'AM', 'AP', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 'MG',
              'MS', 'MT', 'PA', 'PB', 'PE', 'PI', 'PR', 'RJ', 'RN', 'RO', 'RR',
              'RS', 'SC', 'SE', 'SP', 'TO']
        // S83-A — mesmo padrão de lookingFor/uf acima: obrigatório no
        // cadastro, sem o campo (ou fora do enum) o create inteiro é negado.
        && request.resource.data.vale in ['BB', 'CAIXA', 'BRB']
        // S135 — mesmo padrão de lookingFor/uf/vale acima: nickname era
        // obrigatório sozinho aqui, no create, até a S137 abrir a
        // alternativa `name` abaixo (client legado) — hoje um dos dois é
        // obrigatório, não mais só nickname; isValidProfile trata nickname
        // como opcional pra não travar contas legadas no update, ver
        // comentário lá.
        // S137 — TEMPORARIO: client do build 14 (Android) / 1.0.5 (iOS), ainda
        // publicado nas lojas, escreve `name` (não `nickname`) no create. Sem
        // este ramo, o create dele quebra: falta `nickname` obrigatório E `name`
        // não está mais no hasOnly desde a S135. Aceita OS DOIS formatos, mas
        // EXCLUSIVOS entre si NO CREATE (evita doc nascer ambíguo) — remover
        // o ramo `name` (e 'name' do hasOnly abaixo) quando o build 15
        // substituir os dois nas lojas.
        // Conserta só o create — o allow update (intocado) segue com
        // `name` fora do hasOnly de affectedKeys: uma conta nascida aqui só
        // com `name` (build 14) tem o PRIMEIRO save de perfil negado por
        // inteiro (bio/fotos/tudo junto) se a pessoa editar o nome nessa
        // tela, porque `name` não é uma chave alterável no update. E como o
        // update não impede a coexistência, uma conta assim pode ganhar
        // `nickname` depois (build novo) sem nunca perder o `name` antigo —
        // a exclusividade daqui só vale no instante do create. Migração
        // futura (rodar migrateNicknames.js de novo após o build 15
        // substituir os dois) precisa achar tanto doc só-name quanto doc
        // com os dois campos.
        && (
             (request.resource.data.nickname is string
               && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 120
               && !('name' in request.resource.data))
             ||
             (request.resource.data.name is string
               && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 240
               && !('nickname' in request.resource.data))
           )
        && request.resource.data.keys().hasOnly(
             ['uid', 'nickname', 'name', 'age', 'birthDate', 'bio', 'photoURL', 'photos', 'interests',
              'gender', 'lookingFor', 'uf', 'vale', 'location', 'filters', 'createdAt', 'prompts',
              'places', 'events', 'weeklyPromptAnswer'])
        && isValidProfile(request.resource.data);

      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        // Versão estrita: compara presença ANTES (resource.data) e DEPOIS
        // (request.resource.data), não só o resultado isolado. Dois ramos:
        // (a) ausente nos dois — conta de teste sem o campo continua
        //     editando bio/foto/etc. sem travar; (b) presente no resultado
        //     e com valor válido — cobre tanto "já tinha e trocou entre as
        //     4 opções" quanto "não tinha e está definindo pela 1ª vez fora
        //     do cadastro". Fora desses dois ramos só sobra o caso "tinha
        //     antes e sumiu no resultado" — nenhum dos dois ramos cobre
        //     isso, então fica negado: não dá pra remover o campo depois de
        //     setado.
        && ((!('lookingFor' in resource.data) && !('lookingFor' in request.resource.data))
            || ('lookingFor' in request.resource.data && request.resource.data.lookingFor in
                  ['relacionamento_serio', 'casual', 'amizade', 'descobrindo']))
        // S44 — mesmo padrão do ramo de lookingFor acima, aplicado a uf: (a)
        // ausente nos dois — conta legada sem uf segue editando bio/foto/etc.
        // sem travar; (b) presente no resultado e com sigla válida — cobre
        // tanto "já tinha e trocou entre as 27" quanto "não tinha e está
        // definindo pela 1ª vez fora do cadastro". O caso "tinha antes e
        // sumiu no resultado" não cai em nenhum dos dois ramos, então fica
        // negado — não dá pra remover uf depois de setado.
        && ((!('uf' in resource.data) && !('uf' in request.resource.data))
            || ('uf' in request.resource.data && request.resource.data.uf in
                  ['AC', 'AL', 'AM', 'AP', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 'MG',
                   'MS', 'MT', 'PA', 'PB', 'PE', 'PI', 'PR', 'RJ', 'RN', 'RO', 'RR',
                   'RS', 'SC', 'SE', 'SP', 'TO']))
        // S83-A — vale é GRAVÁVEL UMA VEZ, diferente do padrão "troca livre
        // entre as opções" de lookingFor/uf acima: contas que já existem não
        // têm o campo, e travar como imutável de cara as deixaria presas sem
        // poder nunca definir o primeiro valor — por isso o 1º set continua
        // liberado. Mas depois de definido, não muda mais. Três ramos: (a)
        // ausente nos dois — conta sem o campo segue editando o resto sem
        // travar; (b) já existia E continua no resultado E É O MESMO valor —
        // qualquer tentativa de trocar (ou remover, que cai fora dos 3 ramos)
        // é negada; (c) não existia antes e aparece agora — aí, e só aí,
        // precisa estar dentro do enum (1ª definição, fora do cadastro).
        && ((!('vale' in resource.data) && !('vale' in request.resource.data))
            || ('vale' in resource.data && 'vale' in request.resource.data
                  && request.resource.data.vale == resource.data.vale)
            || (!('vale' in resource.data) && 'vale' in request.resource.data
                  && request.resource.data.vale in ['BB', 'CAIXA', 'BRB']))
        // S76-B1, migrado na S135: a trava de nome IMUTÁVEL pós-verificação
        // saiu daqui — `name` deixou de existir no doc público (vira
        // `nickname`, sem trava nenhuma, editável sempre) e o NOME REAL
        // passou a morar em users/{uid}/private/legalName, subdocumento
        // próprio com a mesma trava (ver match /private/legalName abaixo,
        // logo após /private/registration). Motivo de não dar pra manter a
        // trava em cima de `nickname`: nickname é público e não é mais a
        // identidade que o revisor confere contra a selfie — travar ele
        // pós-verificação não faria sentido de produto nem resolveria nada.
        // S76-B2 — birthDate IMUTÁVEL a partir da aprovação da verificação,
        // mesma lógica do nome logo acima: o revisor humano confere a
        // identidade, e a idade derivada dessa data passa a ser uma
        // afirmação que o selo cobre. Cobre os mesmos três casos da guarda
        // do vale, escrito em duas condições porque o caso "ausente antes"
        // não precisa de checagem de enum — isValidProfile já valida
        // formato e faixa de birthDate quando o campo está presente:
        // (a) não verificado -> livre; (b) verificado mas SEM birthDate ->
        // primeira gravação liberada, senão conta já verificada que nunca
        // teve o campo (toda a base legada) ficaria impedida PRA SEMPRE de
        // receber um na migração; (c) verificado e COM birthDate -> só passa
        // se o valor for idêntico. Remover o campo cai fora das três e fica
        // negado.
        && (resource.data.get('verified', false) != true
            || !('birthDate' in resource.data)
            || ('birthDate' in request.resource.data
                && request.resource.data.birthDate == resource.data.birthDate))
        // S76-B2 — NÃO travar `age`: o handleSave passa a gravar a idade
        // RECALCULADA (ver ProfileScreen), então uma pessoa verificada que
        // salvar o perfil depois do aniversário manda um `age` diferente do
        // gravado. Travar `age` faria esse save ser negado por inteiro.
        // Quem trava a identidade é o birthDate; o age precisa poder subir.
        // S138 — `nickname` sai desta lista: deixa de ser gravável pelo
        // dono em QUALQUER circunstância (não é mais condicional a
        // verified, é sempre negado). Única via de correção agora é o
        // admin, no allow update isolado logo abaixo (affectedKeys().hasOnly(
        // ['nickname'])), a partir de um chamado de suporte
        // (AdminSupportDetailScreen).
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['age', 'birthDate', 'bio', 'photoURL', 'photos', 'interests',
              'gender', 'lookingFor', 'uf', 'vale', 'location', 'filters', 'prompts', 'lastActiveAt',
              'reengagementOptOut', 'paused', 'places', 'events', 'weeklyPromptAnswer', 'about',
              'aboutHidden', 'poll'])
        // lastActiveAt só entra via serverTimestamp() do client — se a chave
        // foi tocada nesta escrita, o valor tem que ser o horário do próprio
        // servidor, nunca um timestamp arbitrário mandado pelo client.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastActiveAt'])
            || request.resource.data.lastActiveAt == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reengagementOptOut'])
            || request.resource.data.reengagementOptOut is bool)
        && isValidProfile(request.resource.data);

      allow delete: if isOwner(userId);

      // S138 — via de escrita isolada pro admin corrigir SÓ o nickname, a
      // partir de um chamado de suporte (AdminSupportDetailScreen). O dono
      // não tem mais nenhuma via de alteração (nickname saiu do hasOnly do
      // allow update acima); esta é a única forma de mudar o campo depois
      // do cadastro. `request.resource.data.diff(resource.data).affectedKeys()`
      // por extenso (não `affectedKeys()` solto) — mesmo molde usado em
      // todo outro ponto deste arquivo (não existe helper bare nas Rules).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 120;

      // ─────────────── users/{userId}/private ───────────────
      // Dois documentos com regras próprias (não um wildcard único), porque
      // têm mutabilidade diferente: o push token é regravado a cada refresh;
      // o ChaveF (S-ChaveF) é criado uma vez e só volta a ser gravável numa
      // janela específica (S75 — ver comentário do próprio doc abaixo).

      // users/{userId}/private/push — token do Expo push, só o dono lê/escreve.
      match /private/push {
        allow read, write: if isOwner(userId);
      }

      // users/{userId}/private/registration — ChaveF capturado no cadastro.
      // Nunca exposto no doc público users/{userId} (que tem read amplo pra
      // qualquer autenticado, por causa do Swipe/Discover) — só o dono e o
      // admin enxergam.
      //
      // S75 — deixou de ser imutável: o dono pode CORRIGIR o chaveF, mas só
      // enquanto verifications/{uid}.status == 'rejected' (get() cruzado
      // abaixo — decisão de produto: correção liberada independente do
      // motivo da recusa, não só chave_f_invalida). Fora dessa janela (sem
      // verification, pending, ou approved), o update continua negado, na
      // prática tão imutável quanto antes. `createdAt` é preservado
      // (request.resource.data.createdAt == resource.data.createdAt) — a
      // correção não é um novo cadastro, é o mesmo registro com o campo
      // certo. `chaveF` continua validado pelo mesmo formato do create.
      match /private/registration {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && request.resource.data.chaveF is string
          && request.resource.data.chaveF.matches('^[A-Z]?\\d{1,7}$') // formato relaxado: F+7 ainda casa
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['chaveF', 'createdAt']);

        allow update: if isOwner(userId)
          && exists(/databases/$(database)/documents/verifications/$(userId))
          && get(/databases/$(database)/documents/verifications/$(userId)).data.status == 'rejected'
          && request.resource.data.chaveF is string
          && request.resource.data.chaveF.matches('^[A-Z]?\\d{1,7}$') // formato relaxado: F+7 ainda casa
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasOnly(['chaveF', 'createdAt']);

        allow delete: if false;
      }

      // users/{userId}/private/legalName (S135) — nome real/completo, o que
      // era o campo `name` de users/{userId} até esta sprint. Sai do doc
      // público (que agora só tem `nickname`, sem trava nenhuma) porque o
      // nome real deixa de ser exibido em QUALQUER canto do app — vira
      // referência interna, usada só pelo próprio dono e pelo time de
      // verificação (revisor confere selfie contra a Chave F e, agora,
      // contra este subdocumento em vez do doc público). Mesmo molde de
      // allow read de private/registration acima: isOwner || isAdmin.
      match /private/legalName {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 240
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['name', 'createdAt']);

        // Trava S76-B1, migrada da S135: nome real imutável a partir da
        // aprovação da verificação humana. Antes da aprovação, o dono pode
        // corrigir (mesma lógica pré-S135, só que agora o campo travado não
        // é mais `users/{uid}.name` e sim este subdocumento). `verified`
        // mora no doc PAI (users/{userId}), não aqui — por isso o get()
        // cruzado, molde igual ao usado em pollVotes (linha ~590) e não o
        // "mesmo doc" que o antigo S76-B1 usava (lá o campo travado e o
        // campo `verified` estavam no mesmo documento).
        //
        // S138 — trava S76-B1 acima SUBSTITUÍDA: nome real vira IMUTÁVEL
        // pelo dono sempre, não mais condicional a verified (nem a
        // pré-verificação segue liberada). `if false` — mesma trava do
        // nickname no doc pai (ver users/{userId} allow update acima).
        // Única via de correção agora é o admin, no allow update isolado
        // logo abaixo, a partir de um chamado de suporte
        // (AdminSupportDetailScreen).
        allow update: if false;

        // S138 — via de escrita isolada pro admin corrigir SÓ o name, mesmo
        // molde do allow update isolado de nickname no doc pai (users/
        // {userId} acima).
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 240;

        // S138 (correção pós-auditoria) — allow create pro admin, paridade
        // com o create-path do dono acima. Cobre conta legada cujo
        // subdocumento private/legalName ainda não existe (comentário em
        // firestoreService.ts confirma esse caso): sem este create, a via de
        // correção do admin ficaria sem saída — allow update não vale pra
        // doc inexistente.
        allow create: if isAdmin()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 240
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['name', 'createdAt']);

        allow delete: if false;
      }
    }

    // ───────────────────────── users/{ownerUid}/pollVotes/{voterUid} (S126 — Enquete no perfil) ─────────────────────────
    //
    // Um voto por par dono/visitante, imutável (create-only). `allow read`
    // deliberadamente restrito a request.auth.uid == voterUid — o DONO
    // (ownerUid) NÃO está na condição: ele fisicamente não consegue ler quem
    // votou o quê, só o agregado (users/{uid}.pollCounts, escrito só pela
    // Cloud Function onPollVoteCreated via Admin SDK, fora de qualquer
    // hasOnly de create/update de users/{userId} acima). O próprio votante lê
    // o próprio voto pra saber se já respondeu.
    match /users/{ownerUid}/pollVotes/{voterUid} {
      allow read: if isSignedIn() && request.auth.uid == voterUid;

      allow create: if isSignedIn()
        && request.auth.uid == voterUid
        && voterUid != ownerUid
        && request.resource.data.keys().hasOnly(['optionIndex', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.optionIndex is int
        && request.resource.data.optionIndex >= 0
        && exists(/databases/$(database)/documents/users/$(ownerUid))
        && get(/databases/$(database)/documents/users/$(ownerUid)).data.poll.options.size()
            > request.resource.data.optionIndex;

      allow update: if false; // voto é imutável — nunca se reescreve, só se cria
      allow delete: if false; // sem "desfazer voto" nesta sprint
    }

    // ───────────────────────── users/{ownerUid}/photoLikes/{likeId} (S123 — Curtir foto) ─────────────────────────
    //
    // Toggle (curtir/descurtir), só em pós-match (MatchProfileScreen client,
    // fora destas rules). likeId determinístico
    // `${likerUid}_${encodeURIComponent(photoUrl)}` — permite setDoc/
    // deleteDoc diretos, sem query prévia. Curtida NÃO é anônima (allow read
    // aberto, mesma abertura de match /users/{userId} acima), mas esta
    // sprint só expõe o contador no client, sem lista de curtidores.
    match /users/{ownerUid}/photoLikes/{likeId} {
      allow read: if isSignedIn(); // mesma abertura de match /users/{userId} — não é anônimo (decisão 7)

      allow create: if isSignedIn()
        && request.resource.data.likerUid == request.auth.uid
        && request.resource.data.likerUid != ownerUid
        && request.resource.data.keys().hasOnly(['photoUrl', 'likerUid', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.photoUrl is string
        && exists(/databases/$(database)/documents/users/$(ownerUid))
        && request.resource.data.photoUrl in get(/databases/$(database)/documents/users/$(ownerUid)).data.photos;

      allow update: if false;
      allow delete: if isSignedIn() && resource.data.likerUid == request.auth.uid;
    }

    // ───────────────────────── users/{uid}/achievements/{achievementId} (S127 — Marcos e selos) ─────────────────────────
    //
    // 3 conquistas determinísticas nesta sprint (firstMatch, profileComplete,
    // tenDaysInApp — catálogo em src/constants/achievements.ts), doc =
    // {unlockedAt: serverTimestamp}. Create-only, escrita EXCLUSIVA por Cloud
    // Function via Admin SDK (onMatchCreated/onUserProfileUpdated/
    // tenDaysInAppCheck em functions/src/index.ts) — mesmo padrão
    // Cloud-Function-only já usado por founderNumber/pollCounts: `allow
    // write: if false` bloqueia o client por completo, inclusive o próprio
    // dono, e o Admin SDK ignora esta regra normalmente.
    match /users/{uid}/achievements/{achievementId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ───────────────────────── users/{uid}/superLikes/usage (Super Like Fase 2) ─────────────────────────
    //
    // Contador mensal de superlikes, em caminho absoluto (em vez de aninhado
    // em match /users/{userId} acima) pra não colidir o nome da variável de
    // path com o {userId} já usado ali. year/month são sempre UTC (bate com
    // request.time.year()/month(), que o servidor calcula em UTC) e o count
    // só pode subir de 1 em 1 dentro do mesmo mês, ou resetar pra 1 num mês
    // novo — nunca decrementar nem pular direto pra um valor maior.
    match /users/{uid}/superLikes/usage {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['year', 'month', 'count'])
        && request.resource.data.year == request.time.year()
        && request.resource.data.month == request.time.month()
        && request.resource.data.count == 1;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['year', 'month', 'count'])
        && request.resource.data.year == request.time.year()
        && request.resource.data.month == request.time.month()
        && (
          (resource.data.year == request.time.year()
            && resource.data.month == request.time.month()
            && request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= 3)
          ||
          ((resource.data.year != request.time.year()
            || resource.data.month != request.time.month())
            && request.resource.data.count == 1)
        );
      allow delete: if false;
    }

    // ───────────────────────── users/{uid}/superLikes/dailyGrant (S128 — Super Curtida diária) ─────────────────────────
    //
    // Data (UTC) do último grant diário grátis consumido — doc irmão do
    // usage acima, mesma coleção. Não tem contador: create/update só grava
    // year/month/day de HOJE (bate com request.time.year()/.month()/.day()),
    // e só é permitido quando o valor anterior do doc (se existir, via
    // resource.data) tem data diferente de hoje — se bater com hoje, o
    // grant já foi usado e a escrita é negada. Ver bloco swipes/{swipeId}
    // create abaixo (ramo A) pra como isso trava a segunda super curtida do
    // dia a cair na cota mensal.
    match /users/{uid}/superLikes/dailyGrant {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['year', 'month', 'day'])
        && request.resource.data.year == request.time.year()
        && request.resource.data.month == request.time.month()
        && request.resource.data.day == request.time.day();
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['year', 'month', 'day'])
        && request.resource.data.year == request.time.year()
        && request.resource.data.month == request.time.month()
        && request.resource.data.day == request.time.day()
        && (
          resource.data.year != request.time.year()
          || resource.data.month != request.time.month()
          || resource.data.day != request.time.day()
        );
      allow delete: if false;
    }

    // ───────────────────────── users/{uid}/replies/usage (S74 — quota de "Responder") ─────────────────────────
    //
    // Contador mensal de respostas (bilhete em curtida normal, via prompt),
    // espelhando users/{uid}/superLikes/usage acima: mesma forma de doc
    // (year/month/count), mesmas garantias (dono lê/escreve só o próprio,
    // count só sobe de 1 em 1 no mesmo mês ou reseta pra 1 num mês novo).
    // S74-A só cria e passa a gravar este contador — nada aqui ainda BLOQUEIA
    // uma resposta por falta de quota; isso é o S74-B, no bloco do `note` em
    // swipes/ (400-424 abaixo, intocado nesta rodada).
    match /users/{uid}/replies/usage {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['year', 'month', 'count'])
        && request.resource.data.year == request.time.year()
        && request.resource.data.month == request.time.month()
        && request.resource.data.count == 1;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['year', 'month', 'count'])
        && request.resource.data.year == request.time.year()
        && request.resource.data.month == request.time.month()
        && (
          (resource.data.year == request.time.year()
            && resource.data.month == request.time.month()
            && request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= 3)
          ||
          ((resource.data.year != request.time.year()
            || resource.data.month != request.time.month())
            && request.resource.data.count == 1)
        );
      allow delete: if false;
    }

    // ───────────────────────── swipes ─────────────────────────
    //
    // Leitura liberada para from==me OU to==me (decisão consciente: a tela
    // "Quem curtiu você" depende de ler swipes onde to==me, antes do match).
    // Ninguém lê swipes de terceiros nem consegue "vasculhar" quem curtiu quem.
    //
    // S49 — null-guard: quando o doc NÃO existe, `resource` é null, e
    // dereferenciar resource.data.from/to nesse caso é avaliado como negado
    // (não como "passa livre") — isso derrubava com permission-denied tanto
    // o getDoc() do swipe recíproco em recordSwipe (firestoreService.ts, lido
    // logo após gravar o próprio swipe com sucesso: todo like sem
    // reciprocidade lançava aqui) quanto o getDoc() do próprio swipe do
    // usuário em MatchProfileScreen (S49, "já curtiu esse perfil?"), mesmo
    // sendo, nos dois casos, "ainda não existe" — uma resposta legítima, não
    // um erro. O ramo `resource == null` abaixo só libera quando o swipeId
    // identifica, pela ESTRUTURA do id (nunca pelo conteúdo, que não
    // existe), um doc onde eu sou uma das duas partes: sufixo `_{eu}` (o
    // recíproco {outro}_{eu} que recordSwipe lê) OU prefixo `{eu}_` (o meu
    // próprio swipe {eu}_{outro} que MatchProfileScreen lê) — exatamente o
    // mesmo escopo do ramo "doc existe" logo abaixo (from==me || to==me),
    // nunca um oráculo de existência pra swipe de terceiros.
    match /swipes/{swipeId} {
      allow read: if isSignedIn()
        && (
          (resource != null
            && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid))
          || (resource == null
              && (swipeId.matches('.+_' + request.auth.uid)
                  || swipeId.matches(request.auth.uid + '_.+')))
        );

      allow create: if isSignedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && swipeId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.direction in ['like', 'nope', 'superlike']
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['from', 'to', 'direction', 'createdAt', 'likedPhotoURL', 'context', 'note'])
        // S35: contexto opcional ("curtiu sua foto") — só existe em
        // like/superlike (nope nunca leva contexto pro alvo); campo
        // ausente continua válido (compat com nope e clients antigos).
        && (
          !('likedPhotoURL' in request.resource.data)
          || (
            request.resource.data.direction != 'nope'
            && request.resource.data.likedPhotoURL is string
            && request.resource.data.likedPhotoURL.size() > 0
            && request.resource.data.likedPhotoURL.size() <= 2048
          )
        )
        // S35-A: mesmo padrão do likedPhotoURL acima, mas como REFERÊNCIA
        // (nunca URL/texto) do que estava visível no card — índice de foto
        // ou id de prompt. Coexiste com likedPhotoURL (client ainda grava os
        // dois); consolidar os dois campos fica pra uma etapa futura.
        && (
          !('context' in request.resource.data)
          || (
            request.resource.data.direction != 'nope'
            && request.resource.data.context is map
            && request.resource.data.context.keys().size() == 2
            && (
              (
                request.resource.data.context.type == 'photo'
                && request.resource.data.context.photoIndex is int
                && request.resource.data.context.photoIndex >= 0
                && request.resource.data.context.photoIndex < 9
              )
              || (
                request.resource.data.context.type == 'prompt'
                && request.resource.data.context.promptId is string
                && request.resource.data.context.promptId.size() > 0
                && request.resource.data.context.promptId.size() < 60
              )
            )
          )
        )
        // S67/S73: bilhete opcional anexado a like ou superlike — sem ser só
        // espaço. Em superlike, o gate de verificado já vem do ramo
        // direction=='superlike' abaixo (S70) — repetir o get() aqui seria a
        // mesma leitura de novo sem motivo. Em like, não existe outro ramo
        // que confirme verified, então o get() entra AQUI DENTRO, só neste
        // caminho (S73) — como o bloco todo só é avaliado quando 'note' está
        // presente no payload (curto-circuito do `!(...) ||` logo abaixo),
        // um like comum sem bilhete nunca paga essa leitura extra. O ramo
        // `!('note' in ...)` continua primeiro de propósito.
        // S77 — 600 = 4x MAX_NOTE_LENGTH (150, SuperLikeNoteModal.tsx):
        // client conta por code point e barra em 150; aqui é só guarda de
        // abuso. Não é número solto — mexer nele significa mexer em
        // MAX_NOTE_LENGTH E aqui.
        && (
          !('note' in request.resource.data)
          || (
            request.resource.data.note is string
            && request.resource.data.note.size() >= 1
            && request.resource.data.note.size() <= 600
            && request.resource.data.note.matches('.*\\S.*')
            && (
              request.resource.data.direction == 'superlike'
              || (
                request.resource.data.direction == 'like'
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verified', false) == true
                // S74-B — quota de "Responder", mesmo desenho do Super Like
                // Fase 2 abaixo (getAfter/exists/get contra o contador
                // escrito no MESMO batch), porém contra
                // users/{uid}/replies/usage — contador próprio, não
                // compartilha cota com superlike. Fica AQUI DENTRO de
                // propósito: este ramo só é avaliado quando 'note' está
                // presente E direction=='like' (curto-circuito dos dois
                // `||` acima), então uma curtida comum sem bilhete nunca
                // paga nenhuma destas leituras.
                && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/replies/usage).data.year == request.time.year()
                && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/replies/usage).data.month == request.time.month()
                && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/replies/usage).data.count <= 3 // REPLY_LIMIT (src/constants/reply.ts) — sincronize manualmente, mesmo padrão do "3" do superlike abaixo (SUPER_LIKE_LIMIT)
                && (
                  !exists(/databases/$(database)/documents/users/$(request.auth.uid)/replies/usage)
                    ? getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/replies/usage).data.count == 1
                    : (
                      (get(/databases/$(database)/documents/users/$(request.auth.uid)/replies/usage).data.year == request.time.year()
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)/replies/usage).data.month == request.time.month())
                        ? getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/replies/usage).data.count == get(/databases/$(database)/documents/users/$(request.auth.uid)/replies/usage).data.count + 1
                        : getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/replies/usage).data.count == 1
                    )
                )
              )
            )
          )
        )
        // Super Like Fase 2: se o swipe é 'superlike', o contador mensal
        // (users/{uid}/superLikes/usage) precisa ter sido escrito no MESMO
        // batch com um incremento real (getAfter reflete a escrita do batch
        // ainda não commitado) — sem isso, um client malicioso criaria o
        // swipe sem gastar cota. As próprias rules do contador acima já
        // impedem resetar/decrementar count dentro do mesmo mês.
        //
        // S70 — verified é a PRIMEIRA condição dentro do parêntese: Rules
        // avalia && em curto-circuito, então um superlike de conta não
        // verificada é negado sem sequer avaliar a quota. Mesmo mecanismo
        // já usado por matches/{matchId}/messages create e, até este
        // sprint, pelo bloco do note acima (ver S67 e a nota do S70 ali).
        && (
          request.resource.data.direction != 'superlike'
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verified', false) == true
            && (
              // S128 — Ramo A: grant diário grátis. A primeira super curtida
              // do dia UTC consome o dailyGrant (escrito no MESMO batch, daí
              // getAfter) em vez do contador mensal — NÃO precisa validar
              // usage aqui. Só é permitido quando o doc não existia antes do
              // write, ou existia com data diferente de hoje (senão o grant
              // de hoje já foi usado — cai no Ramo B).
              //
              // Correção pós-auditoria S128 — existsAfter() como PRIMEIRA
              // condição, curto-circuito antes de qualquer .data.year/month/
              // day: getAfter() de doc inexistente LANÇA ERRO (não retorna
              // false), o que negaria a allow create INTEIRA — não só este
              // ramo. Client pré-S128 nunca escreve dailyGrant no batch (só
              // usage+swipe, como sempre fez), então sem esta guarda todo
              // superlike de app antigo (inclusive via Ramo B, mensal)
              // seria negado até o usuário atualizar o app.
              (
                existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/dailyGrant)
                && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/dailyGrant).data.year == request.time.year()
                && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/dailyGrant).data.month == request.time.month()
                && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/dailyGrant).data.day == request.time.day()
                && (
                  !exists(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/dailyGrant)
                  || get(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/dailyGrant).data.year != request.time.year()
                  || get(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/dailyGrant).data.month != request.time.month()
                  || get(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/dailyGrant).data.day != request.time.day()
                )
              )
              ||
              // Ramo B: cota mensal — validação já existente antes do S128,
              // sem nenhuma alteração de lógica.
              (
                getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/usage).data.year == request.time.year()
                && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/usage).data.month == request.time.month()
                && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/usage).data.count <= 3
                && (
                  !exists(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/usage)
                    ? getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/usage).data.count == 1
                    : (
                      (get(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/usage).data.year == request.time.year()
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/usage).data.month == request.time.month())
                        ? getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/usage).data.count == get(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/usage).data.count + 1
                        : getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/superLikes/usage).data.count == 1
                    )
                )
              )
            )
          )
        );

      allow update: if false; // swipe é imutável — nunca se reescreve, só se cria/apaga

      allow delete: if isSignedIn() && resource.data.from == request.auth.uid; // usado por undoSwipe()
    }

    // ───────────────────────── matches ─────────────────────────
    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;

      // S115 — dois uids admin, hardcoded de propósito: Rules não importa
      // src/config/admin.ts, então estes valores precisam ser mantidos em
      // sincronia manual com ADMIN_UIDS no app. Ninguém dá match com nenhum
      // dos dois admins, nem via API — mesmo `in` de isAdmin() acima, repetido
      // pra cada uid (o array `users` é o alvo do `in` aqui, não o literal, e
      // ambos precisam ficar de fora dele, então não dá pra testar os dois num
      // `in [...]` só).
      allow create: if isSignedIn()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] != request.resource.data.users[1]
        && request.auth.uid in request.resource.data.users
        && !('Gd0pJi8WjYS60JHOnhIx9R6vktJ3' in request.resource.data.users)
        && !('358dfiUwFlbFV0Z3KCyvKXwGGxD3' in request.resource.data.users)
        && (matchId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
            || matchId == request.resource.data.users[1] + '_' + request.resource.data.users[0])
        && mutualLikeExists(request.resource.data.users)
        && request.resource.data.createdAt == request.time
        && (!('typing' in request.resource.data) || request.resource.data.typing == {})
        // blockedBy (S19) e lastMessage (S27) são de propósito ausentes desta
        // lista: só Cloud Functions (Admin SDK — onBlockCreated/onBlockDeleted
        // e onMessageCreated respectivamente) podem escrevê-los. Admin SDK
        // bypassa rules, então isso não impede as functions, só o client.
        && request.resource.data.keys().hasOnly(['users', 'createdAt', 'typing']);

      // Ninguém pode trocar os participantes depois de criado. lastMessage
      // NUNCA aparece aqui — é escrito só pela Cloud Function onMessageCreated
      // via Admin SDK (bypassa rules), o client não tem allow para ele. Do que
      // o client pode mudar: typing (cada um só altera a própria chave — não
      // dá pra forjar "a outra pessoa está digitando") e lastReadAt (S27,
      // idem: cada um só marca a própria leitura, nunca a do outro).
      allow update: if isSignedIn() && request.auth.uid in resource.data.users
        && request.resource.data.users == resource.data.users
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['typing', 'lastReadAt', 'deliveredAt'])
        && resource.data.get('typing', {}).diff(request.resource.data.get('typing', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        // S79-C1 — mesmo padrão do guard de lastReadAt logo abaixo, com um
        // ramo a mais: ou nada mudou em typing, ou a chave do próprio uid
        // não está mais presente no resultado (deleteField, ao parar de
        // digitar — TEM que continuar passando sem exigir tipo), ou ela
        // está presente e o valor tem que ser timestamp E igual a
        // request.time (só serverTimestamp() passa, nunca hora arbitrária
        // mandada pelo client).
        && (resource.data.get('typing', {}).diff(request.resource.data.get('typing', {}))
              .affectedKeys().size() == 0
            || !(request.auth.uid in request.resource.data.get('typing', {}))
            || (request.resource.data.typing[request.auth.uid] is timestamp
                && request.resource.data.typing[request.auth.uid] == request.time))
        && resource.data.get('lastReadAt', {}).diff(request.resource.data.get('lastReadAt', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && (resource.data.get('lastReadAt', {}).diff(request.resource.data.get('lastReadAt', {}))
              .affectedKeys().size() == 0
            || request.resource.data.lastReadAt[request.auth.uid] is timestamp)
        // S129-B — mesmo padrão de lastReadAt acima, pro campo deliveredAt
        // (terceiro tique "entregue"): cada uid só altera a própria chave,
        // valor tem que ser timestamp.
        && resource.data.get('deliveredAt', {}).diff(request.resource.data.get('deliveredAt', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && (resource.data.get('deliveredAt', {}).diff(request.resource.data.get('deliveredAt', {}))
              .affectedKeys().size() == 0
            || request.resource.data.deliveredAt[request.auth.uid] is timestamp);

      // Decisão: qualquer participante pode apagar o match a qualquer momento
      // (usado hoje só por undoSwipe(), mas também funciona como "desfazer
      // match"/unmatch geral). Débito técnico: mensagens da subcoleção ficam
      // órfãs (inacessíveis, mas não deletadas) — limpeza real exigiria uma
      // Cloud Function.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;

      // ─────────────── matches/{matchId}/messages ───────────────
      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in getMatch(matchId).users;

        // blockedBy vazio/ausente (S19) é exigido no create: enquanto alguém
        // tiver o match bloqueado, ninguém — nem quem bloqueou, nem quem foi
        // bloqueado — consegue mandar mensagem, mesmo direto pela API.
        allow create: if isSignedIn()
          && matchAllowsPost(getMatch(matchId), request.auth.uid)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verified', false) == true
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string)
          && (!('location' in request.resource.data) ||
              (request.resource.data.location.latitude is number
               && request.resource.data.location.longitude is number))
          // S79 — citação de mensagem (v1, só texto): map com messageId,
          // senderId e uma CÓPIA truncada do texto original. 400 = 4x o
          // limite do client (100 code points, ver ChatScreen.tsx) — mesma
          // lógica do S77, aqui não é régua de UX, é guarda de abuso. Não é
          // número solto — mexer nele significa mexer no client E aqui.
          && (!('replyTo' in request.resource.data) ||
              (request.resource.data.replyTo is map
               && request.resource.data.replyTo.messageId is string
               && request.resource.data.replyTo.messageId.size() > 0
               && request.resource.data.replyTo.senderId is string
               && request.resource.data.replyTo.text is string
               && request.resource.data.replyTo.text.size() <= 400))
          // S143-B — momentoRef: mesmo molde de replyTo acima, mas apontando
          // pra um MOMENTO (não uma mensagem) — decisão 5, comentar um
          // momento de quem já é match manda mensagem normal aqui, com essa
          // referência truncada pra dar contexto (decisão 7), já que o
          // momento original pode expirar depois. authorId é o uid do autor
          // do momento (== doc id de momentos/{uid}); createdAt é o
          // createdAt ORIGINAL do momento (timestamp, não precisa ser
          // request.time — é cópia, não carimbo desta escrita).
          && (!('momentoRef' in request.resource.data) ||
              (request.resource.data.momentoRef is map
               && request.resource.data.momentoRef.authorId is string
               && request.resource.data.momentoRef.createdAt is timestamp
               && request.resource.data.momentoRef.type in ['text', 'photo']
               && (!('text' in request.resource.data.momentoRef)
                   || (request.resource.data.momentoRef.text is string
                       && request.resource.data.momentoRef.text.size() <= 400))
               && (!('photoUrl' in request.resource.data.momentoRef)
                   || request.resource.data.momentoRef.photoUrl is string)
               && request.resource.data.momentoRef.keys()
                    .hasOnly(['authorId', 'createdAt', 'type', 'text', 'photoUrl'])))
          // mensagem precisa ter algum conteúdo: texto OU foto OU localização
          && (request.resource.data.text.size() > 0
              || 'imageUrl' in request.resource.data
              || 'location' in request.resource.data)
          && request.resource.data.keys().hasOnly(
               ['text', 'senderId', 'createdAt', 'imageUrl', 'location', 'replyTo', 'momentoRef']);

        // S85-B — "apagar pros dois": vira lápide, nunca deleta o doc (por
        // isso allow delete continua false, separado). Update só transforma
        // texto/foto/localização/citação em nada, nas condições abaixo; não
        // existe edição de conteúdo, só esse único caminho de apagar.
        allow update: if (
          isSignedIn()
          && resource.data.senderId == request.auth.uid
          // prazo: 1h a partir do createdAt original, mesma unidade
          // duration.value() já usada em isValidProfile pro cap de idade.
          && request.time < resource.data.createdAt + duration.value(1, 'h')
          // via única: lápide não se reescreve — sem isso um doc já apagado
          // aceitaria update de novo e resetaria deletedAt.
          && !('deletedAt' in resource.data)
          // conteúdo removido de verdade: text/imageUrl/location/replyTo têm
          // que estar AUSENTES no resultado — hasOnly derruba os quatro por
          // construção, não precisa checar campo a campo.
          && request.resource.data.keys().hasOnly(['senderId', 'createdAt', 'deletedAt'])
          // imutáveis preservados — senderId e createdAt não podem mudar de
          // valor no update, só o shape do doc muda.
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.deletedAt == request.time
        ) || (
          // S92 — editar texto de mensagem (ramo separado do apagar, unido por ||):
          // senderId e createdAt preservados por affectedKeys().hasOnly() abaixo;
          // lápide não é editável (!('deletedAt' in ...)); sendMessage grava text SEMPRE,
          // inclusive em foto e localização — por isso a guarda de 'só texto' e a
          // ausência de imageUrl e location, nunca a presença de text.
          request.auth.uid == resource.data.senderId
          && !('deletedAt' in resource.data)
          && !('imageUrl' in resource.data)
          && !('location' in resource.data)
          && request.time < resource.data.createdAt + duration.value(1, 'h')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.editedAt == request.time
        );

        allow delete: if false;
      }

      // ─────────────── matches/{matchId}/hidden (S85-A) ───────────────
      //
      // "Apagar pra mim": doc por USUÁRIO (id = uid), array de messageId que
      // o dono escondeu na própria tela — client-side only, a mensagem em si
      // (matches/{matchId}/messages/{messageId}) continua intacta e o outro
      // participante não é afetado. Sem lápide, sem apagar pros dois (S85-B,
      // fora desta rodada).
      //
      // delete separado e negado: hasOnly() sobre request.resource quebraria
      // em delete (request.resource é null), mesmo motivo do split
      // create/update vs delete em avatars/{uid} no storage.rules.
      match /hidden/{uid} {
        allow read: if isSignedIn()
          && request.auth.uid == uid
          && request.auth.uid in getMatch(matchId).users;

        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && request.auth.uid in getMatch(matchId).users
          && request.resource.data.keys().hasOnly(['messageIds'])
          && request.resource.data.messageIds is list;

        allow delete: if false;
      }

      // ─────────────── matches/{matchId}/reactions (S80-A) ───────────────
      //
      // Um doc por MENSAGEM (id = messageId), map de uid -> emoji (mesmo
      // desenho de matches/{matchId}.typing, S79-C1, só que num doc próprio
      // em vez de campo dentro do match — reações são por mensagem, typing é
      // por conversa). create+update juntos: o doc não existe até a primeira
      // reação naquela mensagem (mesmo motivo do presence/{userId} criado sob
      // demanda, S79-C2-A) — `resource == null` no create normaliza pra {}
      // antes do diff, senão dereferenciar resource.data quebraria.
      //
      // Lista de emoji abaixo TEM que ficar em sincronia manual com
      // REACTION_EMOJIS (src/services/firestoreService.ts) — rules não
      // importa nada do client, os dois lados são mantidos à mão.
      match /reactions/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in getMatch(matchId).users;

        allow create, update: if isSignedIn()
          && request.auth.uid in getMatch(matchId).users
          && (resource == null ? {} : resource.data)
               .diff(request.resource.data).affectedKeys().hasOnly([request.auth.uid])
          // Três ramos, mesmo padrão do guard de `typing` (S79-C1): (1) nada
          // mudou na chave do próprio uid; (2) ela está AUSENTE no
          // resultado — deleteField(), remoção de reação, é o que o S80-B
          // vai usar; (3) está presente e o valor é um dos 6 emoji fixos.
          && ((resource == null ? {} : resource.data)
                .diff(request.resource.data).affectedKeys().size() == 0
              || !(request.auth.uid in request.resource.data)
              || request.resource.data[request.auth.uid]
                   in ['👍', '❤️', '😂', '😮', '😢', '🙏']);

        allow delete: if false;
      }
    }

    // ───────────────────────── groups (S124-A — Grupos: esqueleto) ─────────────────────────
    //
    // Sala de conversa em grupo, com prazo de encerramento (teto 1 mês).
    // Entrada por PEDIDO do usuário + aprovação do criador (não é lista
    // aberta, não é convite direto) — ver members/ e joinRequests/ abaixo.
    // Bloqueio 1:1 (blocks) NÃO tem efeito aqui nesta sprint (decisão de
    // produto): mensagem de grupo nunca recalcula visibilidade por par
    // bloqueado, ao contrário de matches/{matchId}/messages acima.
    match /groups/{groupId} {
      // Leitura ampla pra qualquer autenticado — igual momentos/{uid} (S121)
      // e users/{userId}: a aba "Descobrir" da GroupsScreen precisa listar
      // grupo aberto onde o usuário AINDA NÃO é membro, o que exige poder
      // ler o doc antes de pedir entrada. A LISTA DE MEMBROS (quem está
      // dentro) segue fechada — isso mora em members/ abaixo, com read
      // restrito.
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && (!('description' in request.resource.data)
            || (request.resource.data.description is string
                && request.resource.data.description.size() <= 2000))
        && request.resource.data.createdAt == request.time
        // S149-A — expiresAt vira OPCIONAL ("sem prazo": campo ausente do
        // doc, nunca gravado como null — expireGroups, functions/src/
        // grupos.ts, e a query de listDiscoverableGroups, groupService.ts,
        // já ignoram doc sem o campo em filtro de desigualdade). Quando
        // PRESENTE, validação idêntica à de antes (teto de 30 dias,
        // MAX_GROUP_DURATION_DAYS em groupService.ts).
        && (!('expiresAt' in request.resource.data)
            || (request.resource.data.expiresAt is timestamp
                && request.resource.data.expiresAt > request.time
                && request.resource.data.expiresAt <= request.time + duration.value(30, 'd')))
        && request.resource.data.memberCount == 1
        && request.resource.data.keys().hasOnly(
             ['name', 'description', 'creatorId', 'createdAt', 'expiresAt', 'memberCount']);

      // memberCount é denormalizado, mantido pelo CLIENT (não por Cloud
      // Function) junto com a escrita da subcoleção members/ — sempre no
      // MESMO writeBatch (criação, aprovação, saída). Só o campo memberCount
      // pode mudar por aqui; nome/descrição/prazo são fixos após a criação
      // (sem edição nesta sprint). Dois ramos: sobe 1 (aprovação, só o
      // criador) ou desce 1 (saída, só quem de fato TINHA um doc em
      // members/{auth.uid} antes deste write e não tem mais depois —
      // exists()+!existsAfter() garante que é uma saída de verdade, não um
      // decremento arbitrário de quem nunca foi membro). Não há checagem
      // cruzada de que a aprovação de fato criou um members/{uid} novo no
      // mesmo batch — mesmo grau de rigor que o resto do arquivo aceita pra
      // contador denormalizado (ver comentário "memberCount... mantido pelo
      // client" na spec desta sprint); memberCount é só um número de
      // exibição, não gate de acesso.
      // S124-B (camada 1 — Enquete de grupo) — allow update ganha um SEGUNDO
      // ramo (OR), independente do memberCount abaixo: troca do campo
      // `poll`, restrita ao CRIADOR (request.auth.uid ==
      // resource.data.creatorId — a rule é quem garante de verdade, não a
      // checagem isCreator da UI). Mesma validação de shape já usada em
      // isValidProfile [poll de perfil, ~linha 437] duplicada aqui de
      // propósito: rules não tem função compartilhada entre
      // users/{userId} e groups/{groupId}, e mexer em isValidProfile pra
      // aceitar um shape genérico arriscaria regressão numa validação já em
      // produção. Ausente (deleteField()) é sempre válido — mesmo padrão de
      // about/aboutHidden/poll de perfil. `pollCounts` de propósito NÃO
      // entra em NENHUM hasOnly aqui — só Admin SDK escreve (ver
      // onGroupPollVoteCreated/onGroupPollChanged, functions/src/index.ts).
      allow update: if isSignedIn()
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
            && request.resource.data.memberCount is number
            && (
              (request.resource.data.memberCount == resource.data.memberCount + 1
                && request.auth.uid == resource.data.creatorId)
              ||
              (request.resource.data.memberCount == resource.data.memberCount - 1
                && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)))
            )
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])
            && request.auth.uid == resource.data.creatorId
            && (
              !('poll' in request.resource.data)
              || (
                request.resource.data.poll is map
                && request.resource.data.poll.keys().hasOnly(['question', 'options'])
                && request.resource.data.poll.question is string
                && request.resource.data.poll.question.size() > 0
                && request.resource.data.poll.question.size() <= 100
                && request.resource.data.poll.options is list
                && request.resource.data.poll.options.size() >= 2
                && request.resource.data.poll.options.size() <= 5
              )
            )
          )
        );

      // Sem exclusão antecipada do grupo pelo criador nesta sprint (decisão
      // de produto) — grupo só termina por expiração (função agendada
      // expireGroups) ou pela exclusão de conta do criador (deleteAccount);
      // as duas vias usam Admin SDK, que ignora esta regra.
      allow delete: if false;

      // ─────────────── groups/{groupId}/members ───────────────
      match /members/{uid} {
        // Leitura: o próprio uid sempre pode ler o PRÓPRIO doc (mesmo que
        // ainda não exista — é assim que a tela descobre "eu sou membro?");
        // quem JÁ é membro pode ler a lista inteira (contagem/identificação
        // de membros dentro do grupo).
        allow read: if isSignedIn()
          && (request.auth.uid == uid
              || exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)));

        // Dois caminhos de create: (a) o CRIADOR grava o próprio doc, role
        // 'creator', no MESMO writeBatch que cria o grupo (getAfter, doc pai
        // ainda não existe antes deste batch — mesmo padrão já usado em
        // support/{ticketId}/messages, S38); (b) o criador aprova outro uid,
        // role 'member', só quando existe um joinRequests/{uid} pendente
        // correspondente — aqui o grupo JÁ existe, então get() plain basta.
        allow create: if isSignedIn()
          && request.resource.data.uid == uid
          && request.resource.data.joinedAt == request.time
          && request.resource.data.role in ['creator', 'member']
          && request.resource.data.keys().hasOnly(['uid', 'joinedAt', 'role'])
          && (
            (request.resource.data.role == 'creator'
              && request.auth.uid == uid
              && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == uid)
            ||
            (request.resource.data.role == 'member'
              && get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == request.auth.uid
              && exists(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(uid)))
          );

        // S146 — trocar role/joinedAt continua barrado; único campo
        // liberado é `seenAt` (dot "aceite→solicitante" da aba Explorar
        // some depois que o membro abre GroupDetailScreen — ver
        // markGroupMembershipSeen/GroupDetailScreen.tsx), e só o PRÓPRIO
        // uid grava, com serverTimestamp exigido.
        // S150 — ramo OR novo, campo `messagesSeenAt` (DISTINTO de `seenAt`
        // acima — badge "mensagem nova em grupo", marcado a toda abertura
        // de GroupChatScreen, não só a 1ª vez, ver markGroupMessagesSeen/
        // GroupChatScreen.tsx), mesma trava de só o PRÓPRIO uid gravar com
        // serverTimestamp exigido.
        allow update: if isSignedIn()
          && request.auth.uid == uid
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt'])
              && request.resource.data.seenAt == request.time)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messagesSeenAt'])
              && request.resource.data.messagesSeenAt == request.time)
          );

        // O próprio uid pode apagar o próprio doc (sair), EXCETO se for o
        // criador (decisão de produto: criador não sai, só some via
        // expiração/exclusão de conta). Ninguém apaga doc de outro membro —
        // sem remoção de membro pelo criador nesta sprint.
        allow delete: if isSignedIn() && request.auth.uid == uid && resource.data.role != 'creator';
      }

      // ─────────────── groups/{groupId}/joinRequests ───────────────
      match /joinRequests/{uid} {
        allow read: if isSignedIn()
          && (request.auth.uid == uid
              || request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId);

        // create-only (sem update abaixo): !exists(members/{uid}) barra
        // quem já é membro; a corrida de duplo tap (dois setDoc pro mesmo
        // pedido já existente) cai no allow update: if false logo abaixo,
        // que o client trata como "pedido já enviado", nunca erro genérico
        // (mesmo padrão já usado no projeto pra escrita create-only, ver
        // ROADMAP.md "Padrões de escrita no Firestore").
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.requestedAt == request.time
          && request.resource.data.keys().hasOnly(['uid', 'requestedAt'])
          && !exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid));

        allow update: if false;

        // Cancelar (o próprio requerente) OU rejeitar (o criador do grupo).
        allow delete: if isSignedIn()
          && (request.auth.uid == uid
              || request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId);
      }

      // ─────────────── groups/{groupId}/messages ───────────────
      //
      // Mesmo MOLDE de campos/validação de matches/{matchId}/messages acima
      // (S124-A decisão 11), restrito ao mínimo: só texto e foto, SEM
      // reações/replyTo/read-receipts/edição/exclusão. allow update, delete
      // ficam se false — não existe "apagar pros dois" nem editar aqui
      // nesta sprint (ao contrário do chat 1:1).
      match /messages/{messageId} {
        allow read: if isSignedIn() && groupAllowsPost(groupId, request.auth.uid);

        allow create: if isSignedIn()
          && groupAllowsPost(groupId, request.auth.uid)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verified', false) == true
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string)
          && (request.resource.data.text.size() > 0 || 'imageUrl' in request.resource.data)
          && request.resource.data.keys().hasOnly(['text', 'senderId', 'createdAt', 'imageUrl']);

        allow update, delete: if false;
      }

      // ─────────────── groups/{groupId}/reactions (S149-B) ───────────────
      //
      // Um doc por MENSAGEM (id = messageId), map de uid -> emoji (mesmo
      // desenho de matches/{matchId}.typing, S79-C1, só que num doc próprio
      // em vez de campo dentro do match — reações são por mensagem, typing é
      // por conversa). create+update juntos: o doc não existe até a primeira
      // reação naquela mensagem (mesmo motivo do presence/{userId} criado sob
      // demanda, S79-C2-A) — `resource == null` no create normaliza pra {}
      // antes do diff, senão dereferenciar resource.data quebraria.
      //
      // Lista de emoji abaixo TEM que ficar em sincronia manual com
      // REACTION_EMOJIS (src/services/firestoreService.ts) — rules não
      // importa nada do client, os dois lados são mantidos à mão.
      match /reactions/{messageId} {
        allow read: if isSignedIn() && groupAllowsPost(groupId, request.auth.uid);

        allow create, update: if isSignedIn()
          && groupAllowsPost(groupId, request.auth.uid)
          && (resource == null ? {} : resource.data)
               .diff(request.resource.data).affectedKeys().hasOnly([request.auth.uid])
          // Três ramos, mesmo padrão do guard de `typing` (S79-C1): (1) nada
          // mudou na chave do próprio uid; (2) ela está AUSENTE no
          // resultado — deleteField(), remoção de reação, é o que o S80-B
          // vai usar; (3) está presente e o valor é um dos 6 emoji fixos.
          && ((resource == null ? {} : resource.data)
                .diff(request.resource.data).affectedKeys().size() == 0
              || !(request.auth.uid in request.resource.data)
              || request.resource.data[request.auth.uid]
                   in ['👍', '❤️', '😂', '😮', '😢', '🙏']);

        allow delete: if false;
      }

      // ─── groups/{groupId}/pollVotes (S124-B, camada 1) ───
      //
      // Mirror de users/{ownerUid}/pollVotes/{voterUid} (S126, linha
      // ~686): voto imutável (create-only), allow read restrito ao PRÓPRIO
      // votante — o criador NÃO lê quem votou o quê, só o agregado
      // (groups/{groupId}.pollCounts, escrito só pela Cloud Function
      // onGroupPollVoteCreated via Admin SDK). Diferença em relação ao
      // poll de perfil: exige que quem vota seja MEMBRO do grupo
      // (exists(groups/{groupId}/members/{voterUid})) — perfil não tem
      // conceito de "membro". Sem restrição de voterUid != creatorId (ao
      // contrário do poll de perfil): o criador é membro do próprio grupo
      // e pode votar na própria enquete, cenário normal aqui.
      match /pollVotes/{voterUid} {
        allow read: if isSignedIn() && request.auth.uid == voterUid;

        allow create: if isSignedIn()
          && request.auth.uid == voterUid
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(voterUid))
          && request.resource.data.keys().hasOnly(['optionIndex', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.optionIndex is int
          && request.resource.data.optionIndex >= 0
          && exists(/databases/$(database)/documents/groups/$(groupId))
          && get(/databases/$(database)/documents/groups/$(groupId)).data.poll.options.size()
              > request.resource.data.optionIndex;

        allow update: if false; // voto é imutável — nunca se reescreve, só se cria
        allow delete: if false; // sem "desfazer voto" nesta sprint
      }
    }

    // ───────────────────────── events (S125) ─────────────────────────
    //
    // Mirror de groups/{groupId} acima, com 3 diferenças: (1) só usuário
    // VERIFICADO cria (get() cruzado em users/{uid}.verified, mesmo molde
    // do verified de groups/{groupId}/messages); (2) allow read cobre
    // TAMBÉM o histórico pós-evento (~30 dias, até o purge da function
    // expireEvents) pra quem é criador/participante aprovado — não só
    // "ainda não aconteceu"; (3) allow update só tem ramo de INCREMENTO
    // (sem decremento por saída — decisão técnica desta sprint, ver
    // eventService.ts leaveEvent). Título/descrição reusam os MESMOS tetos
    // de name/description de grupo (120/2000) — spec pede copiar, não
    // inventar número novo.
    match /events/{eventId} {
      // allow read UNIFICADO (get + list) split em allow get + allow list,
      // mesma lição da S139 (momentos/{uid}, linha ~2299): o Firestore não
      // consegue provar estruturalmente uma condição dependente de
      // request.time pro conjunto de resultados de uma query, então nega o
      // list INTEIRO com permission-denied — mesmo quando a query do client
      // já filtra por data. Causa raiz do permission-denied da EventsScreen
      // (S125) em listDiscoverableEvents (eventService.ts), que faz
      // collection('events').where('startsAt','>',now): a rule unificada
      // tinha `resource.data.startsAt > request.time` no meio de um OR, e
      // isso bastava pra derrubar o list inteiro.
      allow get: if isSignedIn()
        && (resource.data.startsAt > request.time
            || request.auth.uid == resource.data.creatorId
            || exists(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid)));

      // list (só listDiscoverableEvents hoje): SEM condição de tempo nem de
      // dono/participante — mesmo padrão de "Leitura ampla pra qualquer
      // autenticado" já usado em groups/{groupId} (linha ~1525) e
      // momentos/{uid} (list) acima. A query já filtra startsAt > now do
      // lado do client (eventService.ts) e já exclui eventos onde o uid é
      // participante (filter local pós-listMyEvents) — não repetir aqui,
      // pelo mesmo motivo de improvabilidade estrutural.
      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verified', false) == true
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && (!('description' in request.resource.data)
            || (request.resource.data.description is string
                && request.resource.data.description.size() <= 2000))
        && request.resource.data.startsAt is timestamp
        && request.resource.data.startsAt > request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.participantCount == 1
        && request.resource.data.purgeAt == request.resource.data.startsAt + duration.value(30, 'd')
        && request.resource.data.keys().hasOnly(
             ['creatorId', 'title', 'description', 'startsAt', 'createdAt', 'participantCount', 'purgeAt']);

      // Só quem criou, só pra somar 1 em participantCount (aprovação de
      // participante) — runTransaction lendo o valor FRESCO do lado do
      // client (ver ROADMAP.md "Padrões de escrita no Firestore"), nunca
      // FieldValue.increment(). SEM ramo de decremento: sair do evento
      // (participants/{uid} delete abaixo) não mexe neste campo.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.creatorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount'])
        && request.resource.data.participantCount == resource.data.participantCount + 1;

      // Sem exclusão antecipada pelo criador nesta sprint — evento só
      // termina pelo purge (~30 dias após startsAt, function expireEvents)
      // ou pela exclusão de conta do criador (deleteAccount); as duas vias
      // usam Admin SDK, que ignora esta regra.
      allow delete: if false;

      // ─────────────── events/{eventId}/participants ───────────────
      //
      // Mirror EXATO de groups/{groupId}/members/{uid} — só o nome do
      // papel muda ('participant' em vez de 'member'), mecanismo idêntico:
      // dois ramos de create (criador junto do batch de criação via
      // getAfter; aprovação do criador quando existe joinRequests/{uid}
      // pendente), delete só do próprio uid e nunca do criador.
      match /participants/{uid} {
        allow read: if isSignedIn()
          && (request.auth.uid == uid
              || exists(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid)));

        allow create: if isSignedIn()
          && request.resource.data.uid == uid
          && request.resource.data.joinedAt == request.time
          && request.resource.data.role in ['creator', 'participant']
          && request.resource.data.keys().hasOnly(['uid', 'joinedAt', 'role'])
          && (
            (request.resource.data.role == 'creator'
              && request.auth.uid == uid
              && getAfter(/databases/$(database)/documents/events/$(eventId)).data.creatorId == uid)
            ||
            (request.resource.data.role == 'participant'
              && get(/databases/$(database)/documents/events/$(eventId)).data.creatorId == request.auth.uid
              && exists(/databases/$(database)/documents/events/$(eventId)/joinRequests/$(uid)))
          );

        // S146 — mirror EXATO do ramo novo de groups/{groupId}/members/{uid}
        // acima: só `seenAt` liberado, só pelo próprio uid, serverTimestamp
        // exigido (badge "aceite→solicitante" — ver
        // markEventParticipationSeen/EventDetailScreen.tsx).
        allow update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt'])
          && request.resource.data.seenAt == request.time;

        allow delete: if isSignedIn() && request.auth.uid == uid && resource.data.role != 'creator';
      }

      // ─────────────── events/{eventId}/joinRequests ───────────────
      //
      // Mirror EXATO de groups/{groupId}/joinRequests/{uid}.
      match /joinRequests/{uid} {
        allow read: if isSignedIn()
          && (request.auth.uid == uid
              || request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.creatorId);

        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.requestedAt == request.time
          && request.resource.data.keys().hasOnly(['uid', 'requestedAt'])
          && !exists(/databases/$(database)/documents/events/$(eventId)/participants/$(uid));

        allow update: if false;

        allow delete: if isSignedIn()
          && (request.auth.uid == uid
              || request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.creatorId);
      }

      // ─────────────── events/{eventId}/private/location ───────────────
      //
      // Decisão de produto (S125): local em TEXTO LIVRE, só legível por
      // quem já foi APROVADO na lista de participantes ou é o criador
      // (decisão 6 — criador nasce participante aprovado no mesmo batch,
      // então "exists(participants/{uid})" já cobre os dois igualmente).
      // Imutável após a criação (decisão 9) — allow update/delete: if
      // false, sem tela de edição nesta sprint.
      match /private/location {
        allow read: if isSignedIn()
          && (request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.creatorId
              || exists(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid)));

        // getAfter (não get()) porque este create acontece no MESMO BATCH
        // que a criação de events/{eventId} — o doc pai ainda não existe
        // ANTES do batch, mesmo padrão já usado no ramo 'creator' de
        // participants/{uid} acima e em groups/{groupId}/members/{uid}.
        allow create: if isSignedIn()
          && getAfter(/databases/$(database)/documents/events/$(eventId)).data.creatorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['text', 'createdAt']);

        allow update: if false;
        allow delete: if false;
      }
    }

    // ───────────────────────── collection group reads (S124-A) ─────────────────────────
    //
    // CONTRAINTUITIVO — não apagar/consolidar isto achando que é duplicata
    // das regras aninhadas `groups/{groupId}/members/{uid}` e
    // `groups/{groupId}/joinRequests/{uid}` acima. Uma regra aninhada só
    // autoriza LER UM DOC ESPECÍFICO (get/onSnapshot de um path completo,
    // com groupId já conhecido) — ela NÃO cobre uma query
    // `collectionGroup('members')`/`collectionGroup('joinRequests')`, que
    // varre a subcoleção através de TODOS os grupos de uma vez sem o client
    // saber o groupId de antemão. Pra uma collection group query ser
    // autorizada, o Firestore exige uma regra declarada com o wildcard
    // recursivo `{path=**}` bem aqui, no nível de topo.
    //
    // `listMyGroups` (groupService.ts) usa `collectionGroup('members')` pra
    // achar "em quais grupos eu sou membro" sem manter uma lista própria —
    // sem a regra `members` abaixo, essa query sempre voltava
    // permission-denied e GroupsScreen ("Meus grupos"/"Descobrir") nunca
    // carregava. A regra `joinRequests` gêmea não tem chamador no client
    // hoje (o único uso client-side de `collectionGroup('joinRequests')`
    // era pra EXCLUIR grupo com pedido pendente de "Descobrir" — removido
    // na correção pós-auditoria, ver `listDiscoverableGroups`, porque
    // escondia o único jeito de o usuário ver "Pedido enviado"/cancelar);
    // mantida mesmo assim, mesmo molde da irmã `members`, porque é inofensiva
    // (só autoextrada, ver parágrafo abaixo) e cobre o mesmo padrão que o
    // Admin SDK já usa via `collectionGroup('joinRequests')` em
    // `deleteAccount` (functions/src/index.ts — Admin SDK ignora rules, não
    // depende desta regra, mas o padrão de dados é o mesmo).
    //
    // Não amplia o acesso além do que as regras aninhadas já garantiam: o
    // filtro `where('uid', '==', uid)` da própria query, combinado com
    // `resource.data.uid == request.auth.uid` aqui, só deixa cada usuário
    // enxergar o PRÓPRIO doc de participação — nunca o de outro uid, nem
    // por collection group. O criador continua sem conseguir listar
    // joinRequests de OUTROS grupos por aqui (ele já lê os do PRÓPRIO grupo
    // via a regra aninhada acima, que não precisa disto).
    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/joinRequests/{requestUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // S125 — gêmea de members acima, pra events/{eventId}/participants/{uid}
    // (listMyEvents usa collectionGroup('participants')). Nome de
    // subcoleção NOVO no projeto ('participants' não colide com nenhuma
    // regra recursiva existente — confirmado, ver rules-stamp linha 1) —
    // por isso não dá pra reaproveitar a regra `members` acima.
    match /{path=**}/participants/{participantUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ───────────────────────── blocks (S19) ─────────────────────────
    //
    // O client só cria/apaga o doc de bloqueio — nunca escreve users/{uid}.blockedUsers
    // diretamente (ver abaixo). Quem propaga o array pros dois lados e desfaz o
    // match é a Cloud Function onBlockCreated/onBlockDeleted (Admin SDK, ignora
    // estas regras) — ver functions/src/index.ts.
    //
    // Leitura restrita a quem bloqueou (ninguém lê "quem me bloqueou" por aqui —
    // essa informação só existe agregada, e sem direção, no array blockedUsers
    // de cada perfil, que já é público por causa do Descobrir/Swipe).
    match /blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blocker == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.blocker == request.auth.uid
        && request.resource.data.blocked is string
        && request.resource.data.blocked != request.auth.uid
        && blockId == request.resource.data.blocker + '_' + request.resource.data.blocked
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['blocker', 'blocked', 'createdAt']);

      allow update: if false; // bloqueio é imutável — só se cria/apaga

      allow delete: if isSignedIn() && resource.data.blocker == request.auth.uid; // usado por unblockUser()
    }

    // ───────────────────────── reports (S19, S96-A) ─────────────────────────
    //
    // Até a S96-A a denúncia era só de ida (ninguém lia, editava ou apagava
    // pelo client). A partir daqui ganha uma thread, igual a support: quem
    // denunciou (reporterId) e o admin podem ler e conversar — o
    // DENUNCIADO (reportedId) segue sem NUNCA ler, decisão de produto que
    // não mudou.
    match /reports/{reportId} {
      allow read: if isAdmin() || resource.data.reporterId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedId is string
        && request.resource.data.reportedId != request.auth.uid
        && request.resource.data.reason in
             ['spam', 'offensive_content', 'fake_profile', 'inappropriate_behavior', 'other']
        // S77 — 2000 = 4x o maxLength do ReportModal.tsx (500): client conta
        // por code point; aqui virou guarda de abuso, não é número solto —
        // mexer nele significa mexer no maxLength do ReportModal E aqui.
        && request.resource.data.details is string && request.resource.data.details.size() <= 2000
        // S68 — details é opcional pro usuário no formulário (ReportModal),
        // mas o client sempre manda a chave como string, vazia quando
        // deixado em branco (ver reportUser em blockService.ts: `details ??
        // ''`) — nunca ausente, por isso não há ramo `!('details' in ...)`
        // aqui. Vazia continua permitida; só barra string SÓ espaço.
        && (request.resource.data.details.size() == 0
            || request.resource.data.details.matches('.*\\S.*'))
        && request.resource.data.createdAt == request.time
        // S96-A — status é OPCIONAL no create: testadores em campo estão
        // rodando um build cujo reportUser (blockService.ts) ainda não
        // manda esse campo, e exigi-lo quebraria a denúncia deles até
        // atualizarem o app. Ausente == pendente (mesma leitura em
        // listenReports, reportService.ts, que por isso não filtra por
        // status). Quando presente, só pode nascer 'open', nunca já
        // 'resolved'.
        && (!('status' in request.resource.data)
            || request.resource.data.status == 'open')
        // S102-C — denúncia de uma mensagem específica do chat, reusando
        // esta mesma coleção/fila (S96): os 4 campos abaixo são opcionais,
        // client sempre manda matchId/messageId/messageText juntos (ou
        // nenhum dos três), messageImageUrl só quando a mensagem tinha
        // foto — não há regra extra de dependência cruzada entre eles,
        // decisão de produto. messageText é uma CÓPIA truncada do texto
        // original, mesmo teto de replyTo.text (400, linha ~879 acima).
        && (!('matchId' in request.resource.data) || request.resource.data.matchId is string)
        && (!('messageId' in request.resource.data) || request.resource.data.messageId is string)
        && (!('messageText' in request.resource.data)
            || (request.resource.data.messageText is string
                && request.resource.data.messageText.size() <= 400))
        && (!('messageImageUrl' in request.resource.data)
            || request.resource.data.messageImageUrl is string)
        // S121 — denúncia de um momento (story de 24h), mesmo mecanismo dos
        // 4 campos de mensagem acima: momentoId é o uid do autor (== doc ID
        // de momentos/{uid}), momentoText/momentoPhotoUrl são cópia
        // truncada, não referência viva.
        && (!('momentoId' in request.resource.data) || request.resource.data.momentoId is string)
        && (!('momentoText' in request.resource.data)
            || (request.resource.data.momentoText is string
                && request.resource.data.momentoText.size() <= 400))
        && (!('momentoPhotoUrl' in request.resource.data)
            || request.resource.data.momentoPhotoUrl is string)
        // S124-A — denúncia de um grupo (GroupDetailScreen/GroupChatScreen),
        // mesmo mecanismo dos campos opcionais acima: groupId é o ID do doc
        // groups/{groupId}; reportedId, nesse caso, é o creatorId do grupo
        // (decidido pelo CLIENT em blockService.reportUser, não aqui —
        // reportedId continua string livre igual sempre foi). groupName é
        // cópia truncada, mesmo teto de momentoId/messageId (sem teto
        // próprio) mas com teto explícito de 120 (mesmo cap do nome do
        // grupo em groups/{groupId}.name).
        && (!('groupId' in request.resource.data) || request.resource.data.groupId is string)
        && (!('groupName' in request.resource.data)
            || (request.resource.data.groupName is string
                && request.resource.data.groupName.size() <= 120))
        // S125 — denúncia de um evento (EventDetailScreen), mesmo mecanismo
        // dos campos opcionais de groupId/groupName acima: eventId é o ID
        // do doc events/{eventId}; reportedId, nesse caso, é o creatorId do
        // evento (decidido pelo CLIENT em blockService.reportUser, decisão
        // 8 — nunca um participante específico). eventName é cópia
        // truncada, mesmo teto de groupName (120).
        && (!('eventId' in request.resource.data) || request.resource.data.eventId is string)
        && (!('eventName' in request.resource.data)
            || (request.resource.data.eventName is string
                && request.resource.data.eventName.size() <= 120))
        // S143-B — denúncia dentro de um pedido de conversa sem match
        // (momentoRequests/{requestId}, MomentoRequestChatScreen), mesmo
        // mecanismo dos campos opcionais acima: momentoRequestId é o ID do
        // doc momentoRequests/{requestId}; momentoRequestSenderId é o
        // senderId ORIGINAL do pedido (contexto de qual dos dois papéis —
        // autor ou remetente — era o senderId, já que reportedId sozinho
        // não diz isso). Sem campo de texto adicional aqui de propósito —
        // o conteúdo denunciado já é o texto puro da própria mensagem/
        // pedido, sem novo teto pra inventar.
        && (!('momentoRequestId' in request.resource.data)
            || request.resource.data.momentoRequestId is string)
        && (!('momentoRequestSenderId' in request.resource.data)
            || request.resource.data.momentoRequestSenderId is string)
        && request.resource.data.keys().hasOnly(
             ['reporterId', 'reportedId', 'reason', 'details', 'createdAt', 'status',
              'matchId', 'messageId', 'messageText', 'messageImageUrl',
              'momentoId', 'momentoText', 'momentoPhotoUrl', 'groupId', 'groupName',
              'eventId', 'eventName', 'momentoRequestId', 'momentoRequestSenderId']);

      // S96-A — só o admin decide o desfecho, e só alternando status entre
      // 'open' e 'resolved' — affectedKeys().hasOnly(['status']) garante que
      // reporterId/reportedId/reason/details/createdAt nunca são reescritos
      // por essa via, mesmo padrão do update de verifications acima.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['open', 'resolved'];

      allow delete: if false;

      // ─────────────── reports/{reportId}/messages (S96-A) ───────────────
      //
      // Thread entre quem denunciou e o admin — mesmo padrão de
      // support/{ticketId}/messages, trocando o dono do ticket (uid) pelo
      // reporterId da denúncia. O denunciado nunca lê nem escreve aqui,
      // mesma decisão de produto do match pai.
      match /messages/{messageId} {
        allow read: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/reports/$(reportId)).data.reporterId
                   == request.auth.uid);

        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && (isAdmin()
              || getAfter(/databases/$(database)/documents/reports/$(reportId)).data.reporterId
                   == request.auth.uid)
          // Mesmo teto de 4000 usado em support/{ticketId}/messages (S77) —
          // a tela de thread da denúncia ainda não existe nesta sprint
          // (S96-A é só dados/rules), então não há um maxLength de UI pra
          // espelhar ainda; quando a tela nascer, o maxLength dela precisa
          // ficar em 1/4 deste valor, mesmo padrão de guarda de abuso.
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (request.resource.data.text.size() == 0
              || request.resource.data.text.matches('.*\\S.*'))
          // S113 — imageUrl opcional, mesmo molde do create de
          // matches/{matchId}/messages: string quando presente; mensagem
          // precisa ter texto OU foto (nunca as duas ausentes).
          && (!('imageUrl' in request.resource.data)
              || request.resource.data.imageUrl is string)
          && (request.resource.data.text.size() > 0
              || 'imageUrl' in request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(
               ['senderId', 'text', 'createdAt', 'imageUrl']);

        allow update, delete: if false;
      }
    }

    // ───────────────────────── verifications (S20) ─────────────────────────
    //
    // Pedido de verificação de perfil (selfie). Doc id == uid do usuário — 1
    // pedido por pessoa, reenviar sobrescreve o documento inteiro (por isso o
    // client precisa usar setDoc sem merge: um updateDoc parcial deixaria
    // reviewedAt/reviewedBy antigos no doc e o hasOnly() do dono abaixo
    // rejeitaria o reenvio).
    //
    // Uid do admin hardcoded de propósito (mesmo valor de ADMIN_UID em
    // src/config/admin.ts e do literal já usado na regra de create de
    // matches/{matchId} acima — Rules não importa constantes do app, então
    // os três precisam ficar em sincronia manual). A Cloud Function
    // onVerificationReviewed (Admin SDK, ignora estas regras) é quem
    // sincroniza users/{uid}.verified a partir da mudança de status aqui —
    // ver functions/src/index.ts.
    match /verifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Dono cria/reenvia: só como 'pending', com selfieUrl e createdAt —
      // nunca consegue setar status já aprovado/rejeitado nem escrever
      // reviewedAt/reviewedBy/rejectionReason (hasOnly bloqueia por padrão).
      allow create, update: if isOwner(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.selfieUrl is string
        && request.resource.data.selfieUrl.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['status', 'selfieUrl', 'createdAt']);

      // Admin revisa: só pode mexer em status/reviewedAt/reviewedBy/
      // rejectionReason, e só pra aprovar ou rejeitar — nunca reescreve
      // selfieUrl/createdAt do usuário, então não dá pra forjar uma
      // aprovação por essa via nem pela do dono.
      //
      // S58 — rejectionReason é obrigatório (e precisa ser um dos 6 motivos
      // do catálogo) quando status é 'rejected', e PROIBIDO quando é
      // 'approved' (a chave nem pode aparecer em request.resource.data) —
      // mesmos 6 values de src/constants/rejectionReasons.ts, sincronia
      // manual igual ao padrão já usado pra lookingFor/uf acima.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'rejectionReason'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && (request.resource.data.status == 'approved'
              ? !('rejectionReason' in request.resource.data)
              : 'rejectionReason' in request.resource.data
                  && request.resource.data.rejectionReason in
                       ['chave_f_invalida', 'selfie_ilegivel', 'rosto_nao_confere',
                        'nao_e_ao_vivo', 'varias_pessoas', 'requisitos_gerais']);

      allow delete: if false;
    }

    // ───────────────────────── support (S36-S40) ─────────────────────────
    //
    // Ticket de Ajuda/Fale Conosco. Ao contrário de reports (só de ida), o
    // dono pode ler o próprio ticket. status começa sempre 'open' no create
    // (client nunca cria já 'resolved'). lastMessageAt (S40) é escrito só
    // pela Cloud Function onSupportMessageCreated (Admin SDK, bypassa estas
    // regras) — o client não tem allow para esse campo, nem em create nem
    // em update.
    match /support/{ticketId} {
      allow read: if isAdmin() || resource.data.uid == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in
             ['duvida', 'problema_tecnico', 'denuncia', 'sugestao', 'conta']
        // S77 — 4000 = 4x MAX_MESSAGE_LENGTH (1000, SupportScreen.tsx):
        // client conta por code point; aqui virou guarda de abuso, não é
        // número solto — mexer nele significa mexer em MAX_MESSAGE_LENGTH
        // E aqui.
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 4000
        && request.resource.data.message.matches('.*\\S.*')
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(
             ['uid', 'category', 'message', 'status', 'createdAt']);

      // S38: dono ganhou permissão de update, mas só no campo status, e só
      // pra REABRIR o próprio ticket (resolved -> open, nunca o contrário) —
      // o hasOnly(affectedKeys) abaixo já garante que uid/category/message/
      // createdAt/lastMessageAt do usuário nunca são reescritos por essa
      // via. Admin continua podendo ir pra qualquer direção
      // (open<->resolved), igual reviewVerification em
      // verificationService.ts.
      allow update: if isSignedIn()
        && (isAdmin() || isOwner(resource.data.uid))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (
            request.resource.data.status in ['open', 'resolved']
            && (
              isAdmin()
              || (resource.data.status == 'resolved' && request.resource.data.status == 'open')
            )
          )
        );

      allow delete: if false;

      // ─────────────── support/{ticketId}/messages (S38) ───────────────
      //
      // Mensagens da thread — mesmo padrão de imutabilidade de
      // matches/{matchId}/messages (update/delete: false). senderId é
      // sempre o uid de quem escreveu de verdade, inclusive quando é o
      // admin respondendo — "Equipe JuntaVale" é só rótulo de UI (S39), não
      // existe como dado aqui.
      match /messages/{messageId} {
        allow read: if isAdmin() || (isSignedIn() && getTicket(ticketId).uid == request.auth.uid);

        // getAfter() em vez de getTicket() aqui: no writeBatch de
        // submitSupportTicket, o ticket pai e esta 1ª mensagem nascem no
        // mesmo batch, e get() só enxerga o estado PRÉ-batch (doc pai ainda
        // não existe) — mesmo padrão já usado no getAfter() da quota de
        // superlike em swipes/{swipeId}.
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && (isAdmin()
              || getAfter(/databases/$(database)/documents/support/$(ticketId)).data.uid
                   == request.auth.uid)
          // S77 — 4000 = 4x o maxLength do SupportThreadScreen.tsx (1000),
          // mesmo raciocínio de guarda de abuso do create do ticket acima.
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (request.resource.data.text.size() == 0
              || request.resource.data.text.matches('.*\\S.*'))
          // S113 — imageUrl opcional, mesmo molde do create de
          // matches/{matchId}/messages: string quando presente; mensagem
          // precisa ter texto OU foto (nunca as duas ausentes).
          && (!('imageUrl' in request.resource.data)
              || request.resource.data.imageUrl is string)
          && (request.resource.data.text.size() > 0
              || 'imageUrl' in request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(
               ['senderId', 'text', 'createdAt', 'imageUrl']);

        allow update, delete: if false;
      }
    }

    // ───────────────────────── presence (S79-C2-A) ─────────────────────────
    //
    // Heartbeat de "última vez visto" — grava lastSeenAt a cada 2min
    // enquanto o app está em primeiro plano (ver usePresenceHeartbeat).
    //
    // 1) Por que não mora em users/{uid}: o AuthContext mantém um
    //    onSnapshot em users/{uid} do próprio usuário (o doc de perfil), e
    //    uma batida a cada 2min ali faria esse listener disparar e
    //    re-renderizar tudo que consome o perfil — o SwipeScreen já tem
    //    guarda contra esse tipo de ruído (lastActiveAt sendo tocado por
    //    outro hook). Coleção própria evita o problema na raiz, em vez de
    //    remendar guardas de re-render em cada consumidor do perfil.
    //
    // 2) Por que a leitura é restrita a quem tem match, e não isSignedIn()
    //    como em users/: este doc guarda hora EXATA de atividade, e users/
    //    é enumerável por qualquer autenticado (Descobrir/Swipe) — sem essa
    //    restrição, daria pra montar uma linha do tempo de uso de alguém
    //    específico mesmo sem nunca ter dado match. A escada de texto
    //    ("visto há pouco") é só renderização no client (C2-B) — não é ela
    //    que protege o dado, é esta regra.
    match /presence/{userId} {
      allow read: if isOwner(userId)
        || (isSignedIn()
            && (exists(/databases/$(database)/documents/matches/$(userId + '_' + request.auth.uid))
                || exists(/databases/$(database)/documents/matches/$(request.auth.uid + '_' + userId))));

      allow create, update: if isOwner(userId)
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.keys().hasOnly(['lastSeenAt']);

      allow delete: if false;
    }

    // ───────────────────────── testerSignups ─────────────────────────
    // Captação de testadores pela landing (site/index.html) — formulário
    // público, sem autenticação. Só create, com exatamente 3 campos; leitura
    // é feita pelo Console (Admin SDK ignora rules), nunca pelo client.
    match /testerSignups/{signupId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt', 'source'])
        && request.resource.data.keys().hasAll(['email', 'createdAt', 'source'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 5
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.source == 'site'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    // ───────────────────────── momentos (S121) ─────────────────────────
    //
    // Story que expira em 24h — audiência é a BASE INTEIRA (decisão de
    // produto do ROADMAP), não só matches: nem allow get nem allow list
    // checam amizade ou match, só isSignedIn() (a diferença entre os dois
    // é só a checagem de expiresAt, ver comentários abaixo de cada allow).
    // Doc ID == uid do autor (1 momento ativo por usuário, publicar de
    // novo SOBRESCREVE via setDoc sem merge).
    match /momentos/{uid} {
      // get (leitura por ID direto, ex. getMyMomento): doc expirado
      // (expiresAt <= agora) fica ilegível mesmo antes de a function de
      // limpeza (expireMomentos) rodar e apagar de fato — só evita LEITURA
      // DIRETA POR ID do doc expirado antes da limpeza, não é barreira de
      // segurança: o mesmo doc continua descobrível via allow list logo
      // abaixo, que não checa expiresAt. O client trata permission-denied
      // aqui como "sem momento ativo" (momentoService.ts).
      allow get: if isSignedIn() && resource.data.expiresAt > request.time;

      // list (feed, listenActiveMomentos/onSnapshot): SEM checagem de
      // expiresAt — o Firestore não consegue provar estruturalmente uma
      // condição dependente de request.time pro conjunto de resultados de
      // uma query/listener (muda a cada avaliação), então nega o list
      // inteiro com permission-denied (causa raiz do bug de momento de
      // terceiros não carregar, S139). Filtragem de expirados no feed é
      // responsabilidade exclusiva da query do client (where('expiresAt',
      // '>', ...) em listenActiveMomentos) — mesmo padrão já usado em
      // groups/{groupId} acima ("Leitura ampla pra qualquer autenticado").
      allow list: if isSignedIn();

      allow create, update: if isOwner(uid)
        && request.resource.data.authorId == uid
        && request.resource.data.type in ['text', 'photo']
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        // Janela de 23h-25h em torno de request.time: tolera deriva de
        // relógio do client (expiresAt é calculado localmente, createdAt
        // via serverTimestamp), mesmo raciocínio de duration.value() já
        // usado pra idade aproximada em birthDate (S76-A).
        && request.resource.data.expiresAt >= request.time + duration.value(23, 'h')
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
        && (
             (request.resource.data.type == 'text'
               && request.resource.data.text is string
               && request.resource.data.text.size() > 0
               // 1120 = 4x o teto de 280 code points do client (mesma regra
               // do S77: contagem do client é code point, rules é guarda de
               // abuso em UTF-16 length, 4x de folga).
               && request.resource.data.text.size() <= 1120
               && request.resource.data.text.matches('.*\\S.*')
               && !('photoUrl' in request.resource.data))
             || (request.resource.data.type == 'photo'
               && request.resource.data.photoUrl is string
               && request.resource.data.photoUrl.size() > 0
               && !('text' in request.resource.data))
           )
        && request.resource.data.keys().hasOnly(
             ['authorId', 'type', 'text', 'photoUrl', 'createdAt', 'expiresAt']);

      allow delete: if isOwner(uid);

      // ─────────── momentos/{uid}/likes/{likerUid} (S143-B) ───────────
      //
      // Curtir momento fica ABERTO À BASE INTEIRA (momento é público,
      // decisão 1) — sem exigir match, mesma audiência do momento em si.
      // NÃO é anônima: o autor lista nome/vale de quem curtiu (decisão 6,
      // NUNCA legalName — isso é regra de UI, ver MomentoViewerModal.tsx),
      // mas ao contrário de users/{ownerUid}/photoLikes acima a leitura NÃO
      // é aberta a qualquer autenticado — só o próprio liker (pra saber se
      // já curtiu) ou o autor (lista completa). Doc id == likerUid (1
      // curtida por pessoa por momento) — permite setDoc/deleteDoc diretos,
      // sem query prévia, mesmo padrão de photoLikes. Ninguém curte o
      // próprio momento (decisão 9: likerUid != uid, comparado com o
      // uid do PATH — uid aqui é sempre o mesmo doc pai
      // momentos/{uid}, nunca muda de identidade dentro deste match).
      match /likes/{likerUid} {
        allow read: if isSignedIn()
          && (request.auth.uid == likerUid || request.auth.uid == uid);

        allow create: if isSignedIn()
          && request.auth.uid == likerUid
          && likerUid != uid
          && request.resource.data.likerUid == likerUid
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['likerUid', 'createdAt']);

        allow update: if false;
        allow delete: if isSignedIn() && resource.data.likerUid == request.auth.uid;
      }
    }

    // ───────────── momentoRequests/{authorId}_{senderId}_{momentoCreatedAtMillis} (S143-B) ─────────────
    //
    // Comentar/responder um momento de alguém SEM match cria um "pedido"
    // (decisão 2, molde Instagram: fica pendente até o autor responder,
    // ignorar ou recusar). Doc id determinístico
    // `${authorId}_${senderId}_${momentoCreatedAtMillis}` (momentoCreatedAtMillis
    // = createdAt do momento ORIGINAL em milissegundos) — a semântica
    // NATIVA de create vs update do Firestore já garante no máximo 1 pedido
    // por remetente por INSTÂNCIA do momento (decisão 3): uma vez que o doc
    // exista (pending, answered OU declined), uma segunda tentativa de
    // create no MESMO id vira update aos olhos do Firestore, e só o
    // authorId pode fazer update (ver allow update abaixo) — o mesmo
    // senderId nunca consegue recriar/reenviar pro mesmo trio
    // author/sender/instância, mesmo depois de recusado. Isso é
    // intencional (o client evita a tentativa em vão checando o doc antes,
    // ver momentoRequestService.ts), não precisa de checagem extra de
    // exists() aqui. momentoSnapshot é CÓPIA truncada do momento no
    // instante do pedido (decisão 7/8), não referência viva — sobrevive à
    // expiração do momento original (decisão 8: expireMomentos NUNCA apaga
    // momentoRequests).
    // S143-C (débito registrado na S143-B, decisão 7) — allow create ganha
    // mais uma condição: nega se `request.resource.data.authorId` (autor do
    // momento) está no `blockedUsers` do PRÓPRIO remetente
    // (get(.../users/$(request.auth.uid))). Só o array do remetente
    // importa — a Cloud Function onBlockCreated (functions/src/chat.ts)
    // propaga o uid do outro lado pros DOIS perfis quando um bloqueio é
    // criado, então "eu bloqueei" e "ele me bloqueou" já caem no mesmo
    // array.
    // S143-C (revisão pós-teste de aparelho, 25/08/2026 — decisão de
    // produto do Raphael, revoga o roteamento por match desta sprint):
    // responder um Momento agora é SEMPRE por aqui, independente de match —
    // o client não consulta match nenhum antes de chamar sendMomentoComment
    // (momentoRequestService.ts). Quem já é match e conversa via Momento
    // ganha uma thread SEPARADA do chat do match (momentoRequests, não
    // matches/{matchId}/messages) — não precisou de mudança de rule pra
    // isso, é só o client não tentar mais o caminho match. A regra deste
    // bloco não distingue "tinha match" de "não tinha": nunca distinguiu,
    // decisão 3/4 (1 pedido por remetente por instância, resposta do autor
    // libera a thread) valem igual pros dois casos.
    match /momentoRequests/{requestId} {
      // S143-C (correção de semântica, causa confirmada por log de
      // aparelho/TEMP-DIAG) — a versão anterior (`resource != null &&
      // (dono)`) evitava o CRASH de dereferenciar resource.data num doc
      // inexistente, mas trocou o erro por uma negação igualmente errada:
      // `resource == null` fazia o `&&` inteiro virar false → nega. Só que
      // o getDoc de checagem prévia em sendMomentoComment
      // (momentoRequestService.ts) — pra um id determinístico
      // sender_author_timestamp, ANTES do primeiro pedido a um dado autor —
      // é exatamente uma leitura de doc que ainda NÃO EXISTE, e ISSO É
      // LEGÍTIMO: os 3 caminhos (chip/texto/emoji) continuavam batendo
      // permission-denied nesse getDoc mesmo depois do fix anterior. A
      // semântica certa pra get: doc inexistente é PERMITIDO (devolve
      // exists:false, sem nenhum dado real pra vazar — não há resource.data
      // pra checar dono contra nada); só doc EXISTENTE cai na checagem de
      // dono (senderId/authorId == auth.uid). `resource == null` vira o
      // PRIMEIRO ramo do `||`, não mais um `&&` que nega tudo.
      // S143-C (verificação pós-redesenho) — allow read UNIFICADO (get +
      // list) split em allow get + allow list, mesma lição da S139
      // (momentos/{uid} acima): list (listenReceivedMomentoRequests,
      // listenSentMomentoRequests, momentoRequestService.ts — 2 queries
      // de lista novas desta sprint) nunca itera doc inexistente, então
      // list não precisa (nem pode, pelo mesmo motivo de provabilidade
      // estrutural já registrado) do ramo `resource == null` — só get.
      allow get: if isSignedIn()
        && (resource == null
            || resource.data.senderId == request.auth.uid
            || resource.data.authorId == request.auth.uid);

      allow list: if isSignedIn()
        && (resource.data.senderId == request.auth.uid
            || resource.data.authorId == request.auth.uid);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.senderId != request.resource.data.authorId
        && request.resource.data.authorId is string
        // S143-C (débito da S143-B, decisão 7) — nega o pedido se o autor
        // do momento está no `blockedUsers` do PRÓPRIO remetente (cobre os
        // dois sentidos de bloqueio, ver comentário do bloco acima).
        // S143-C (revisão pós-teste de aparelho — endurecimento defensivo)
        // — exists() ANTES do get(): sem isso, uma conta autenticada sem
        // doc em users/{uid} ainda (janela entre criar a conta no Auth e o
        // 1º setDoc do cadastro, ou qualquer outra inconsistência) faz
        // get(...).data quebrar a avaliação inteira com permission-denied
        // em vez de simplesmente não ter nada em blockedUsers pra checar —
        // mesma classe de bug do resource == null no allow read acima,
        // suspeito vivo do permission-denied ainda sem causa confirmada no
        // teste de aparelho (ver instrumentação TEMP-DIAG S143-C).
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
            || !(request.resource.data.authorId in
                 get(/databases/$(database)/documents/users/$(request.auth.uid))
                   .data.get('blockedUsers', [])))
        // "mesmo limite de tamanho de texto de mensagem de chat" (decisão do
        // escopo) — 2000, mesmo teto de matches/{matchId}/messages.text acima.
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.momentoSnapshot is map
        && request.resource.data.momentoSnapshot.type in ['text', 'photo']
        && request.resource.data.momentoSnapshot.createdAt is timestamp
        // 400 = mesmo teto de momentoRef.text (matches/{matchId}/messages,
        // acima) — mesma cópia truncada, mesmo guarda de abuso.
        && (!('text' in request.resource.data.momentoSnapshot)
            || (request.resource.data.momentoSnapshot.text is string
                && request.resource.data.momentoSnapshot.text.size() <= 400))
        && (!('photoUrl' in request.resource.data.momentoSnapshot)
            || request.resource.data.momentoSnapshot.photoUrl is string)
        && request.resource.data.momentoSnapshot.keys()
             .hasOnly(['type', 'text', 'photoUrl', 'createdAt'])
        && request.resource.data.keys().hasOnly(
             ['authorId', 'senderId', 'text', 'momentoSnapshot', 'status', 'createdAt']);

      // Dois ramos independentes (OR): (a) só o autor decide o desfecho
      // (responder ou recusar) — decisão 4: isso NUNCA cria um match, só
      // abre a subcoleção messages abaixo pra esta thread isolada. Única
      // transição permitida é pending->answered ou pending->declined;
      // affectedKeys().hasOnly(['status']) garante que nenhum outro campo
      // (inclusive momentoSnapshot/text) é reescrito por essa via, mesmo
      // padrão do update de reports/{reportId} (S96-A). (b) S146 — só o
      // SENDER grava `seenAt`, só depois que o pedido já saiu de pending
      // (dot "aceite→solicitante" some depois que o remetente abre
      // MomentoRequestChatScreen — ver markMomentoRequestSeen). (c) S150 —
      // só o AUTHOR grava `authorSeenAt` (DISTINTO de `seenAt` do ramo (b) —
      // badge "mensagem nova", marcado a toda abertura de
      // MomentoRequestChatScreen pelo autor, não só a 1ª vez, ver
      // markMomentoRequestAuthorSeen), só quando o pedido já está
      // 'answered' (só aí existe lastMessage pra comparar, ver
      // useUnreadMomentoAuthorMessages.ts).
      allow update: if isSignedIn()
        && (
          (request.auth.uid == resource.data.authorId
            && resource.data.status == 'pending'
            && request.resource.data.status in ['answered', 'declined']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          ||
          (request.auth.uid == resource.data.senderId
            && resource.data.status in ['answered', 'declined']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt'])
            && request.resource.data.seenAt == request.time)
          ||
          (request.auth.uid == resource.data.authorId
            && resource.data.status == 'answered'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorSeenAt'])
            && request.resource.data.authorSeenAt == request.time)
        );

      allow delete: if false;

      // ─────────── momentoRequests/{requestId}/messages (S143-B) ───────────
      //
      // Só escrevível quando o pedido PAI já foi respondido (status ==
      // 'answered') — decisão 4: chat isolado a estes dois uids específicos
      // (senderId/authorId do pedido pai), SEM nenhuma feature de match
      // (sem imagem/localização/reação/edição/apagar/typing/bloqueio/
      // unmatch — o primeiro comentário já vive em
      // momentoRequests/{requestId}.text, aqui só as mensagens SEGUINTES).
      match /messages/{messageId} {
        // S143-C (revisão pós-teste de aparelho — endurecimento defensivo)
        // — momentoRequestExists(requestId) ANTES de qualquer
        // getMomentoRequest(requestId): getMomentoRequest usa get() puro,
        // que lança erro (não devolve null) pra um requestId sem doc
        // correspondente, derrubando a rule inteira com permission-denied
        // em vez de negar normalmente. Sem este guard, forjar/errar um
        // requestId (ou uma corrida rara) quebraria a leitura/escrita da
        // subcoleção inteira em vez de simplesmente negar.
        allow read: if isSignedIn()
          && momentoRequestExists(requestId)
          && (request.auth.uid == getMomentoRequest(requestId).senderId
              || request.auth.uid == getMomentoRequest(requestId).authorId);

        allow create: if isSignedIn()
          && momentoRequestExists(requestId)
          && getMomentoRequest(requestId).status == 'answered'
          && (request.auth.uid == getMomentoRequest(requestId).senderId
              || request.auth.uid == getMomentoRequest(requestId).authorId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt']);

        allow update, delete: if false;
      }
    }

    // ───────────────────────── deny by default ─────────────────────────
    // Qualquer collection não listada acima (inclusive erros de digitação no
    // nome de uma collection) é bloqueada por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
