// storage.rules
// Regras de PRODUÇÃO — deny by default: todo caminho sem regra explícita é
// bloqueado (ver o catch-all no final do arquivo).
//
// Como aplicar (só quando estiver pronto pra testar):
//   1) Console: Firebase Console → Storage → Regras → colar este arquivo → Publicar
//   2) CLI: firebase deploy --only storage:rules

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ───────────────────────── Helpers ─────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Limite de 10MB + exige content-type image/* em todo upload de foto.
    // Só se aplica em write (request.resource não existe em read).
    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ───────────────────────── avatars ─────────────────────────
    //
    // Um arquivo por foto em avatars/{uid}/{timestamp}.jpg (ver
    // ProfileScreen.tsx / firestoreService.ts uploadProfilePhoto), mesmo
    // padrão já usado em verifications/{uid}/{fileName} abaixo — dono
    // identificado pelo uid no path, não mais pelo nome exato do arquivo.
    //
    // create/update ficam sob isValidImage(); delete fica separado e SEM
    // isValidImage() — em request de delete, request.resource é null, e
    // isValidImage() lê request.resource.size, o que dá erro (== deny) se
    // aplicado também ao delete. Sem esse split, remover uma foto nunca
    // funcionaria.
    //
    // Sem compat com o path antigo avatars/{uid}.jpg de propósito — só
    // contas de teste usavam ele, sem migração necessária.
    //
    // read continua amplo de propósito: Descobrir/Swipe mostra as fotos de
    // qualquer perfil pra qualquer usuário autenticado.
    match /avatars/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ───────────────────────── momento photos (S121) ─────────────────────────
    //
    // Foto de momento (story de 24h). Path images/momentos/{uid}/{timestamp}.jpg,
    // mesmo padrão de path de avatars/{uid} e images/chats/{matchId}. read
    // amplo de propósito: audiência é a base inteira (decisão de produto do
    // S121), não só matches — mesmo raciocínio de avatars/{uid} logo acima.
    match /images/momentos/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ───────────────────────── chat images ─────────────────────────
    //
    // Corrige o bug "Não foi possível enviar a imagem": uploadChatImage()
    // (src/services/firestoreService.ts) sobe em images/chats/{matchId}/{ts}.jpg,
    // caminho que não batia com NENHUMA regra existente (só avatars/ tinha
    // regra) e caía no deny-by-default do Storage — todo upload de foto no
    // chat retornava storage/unauthorized.
    //
    // Restrito aos dois participantes do match, checado via firestore.get()
    // (cross-service rules — sintaxe própria do Storage Rules v2, diferente
    // do get()/exists() do Firestore Rules: aqui é sempre firestore.get(path)
    // com o path completo /databases/(default)/documents/...). Espelha o
    // mesmo check de participante que já existe em firestore.rules pra
    // matches/{matchId}/messages.
    match /images/chats/{matchId}/{fileName} {
      function isParticipant() {
        return isSignedIn()
          && request.auth.uid in
             firestore.get(/databases/(default)/documents/matches/$(matchId)).data.users;
      }

      allow read: if isParticipant();
      // S85-C1 — delete separado, sem isValidImage(): mesmo bug/mesma
      // correção do split em avatars/{uid} acima (request.resource é null
      // em delete, e isValidImage() lê request.resource.size — sem o split,
      // apagar a foto do chat, junto do "apagar pros dois", sempre negaria).
      allow create, update: if isParticipant() && isValidImage();
      allow delete: if isParticipant();
    }

    // ───────────────────────── group chat images (S124-A) ─────────────────────────
    //
    // Foto do chat de grupo, path images/groupChats/{groupId}/{ts}.jpg —
    // mesmo molde de path/regra de images/chats/{matchId} acima, trocando
    // "participante do match" (m.data.users) por "tem doc em
    // groups/{groupId}/members/{uid}" via firestore.get() cross-service:
    // mesma convenção já usada nas outras regras deste arquivo (nunca
    // firestore.exists(), que não é usado em nenhum outro lugar aqui) — se o
    // doc members/{uid} não existir, o próprio get() falha e a expressão
    // inteira nega, mesmo efeito de um exists() explícito.
    match /images/groupChats/{groupId}/{fileName} {
      function isGroupMember() {
        return isSignedIn()
          && firestore.get(
               /databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)
             ).data.uid == request.auth.uid;
      }

      allow read: if isGroupMember();
      allow create, update: if isGroupMember() && isValidImage();
      allow delete: if isGroupMember();
    }

    // ───────────────────────── report images (S113) ─────────────────────────
    //
    // Anexo de foto na thread reports/{reportId}/messages. Mesmo mecanismo de
    // images/chats/{matchId} acima: firestore.get() cross-service pra achar
    // quem é parte da denúncia, trocando "participante do match" por
    // "denunciante ou admin" — mesma dupla que já pode ler/escrever a
    // subcoleção messages em firestore.rules. O denunciado nunca entra aqui,
    // mesma decisão de produto de lá.
    match /images/reports/{reportId}/{fileName} {
      function isReportParty() {
        return isSignedIn()
          && (request.auth.uid in ['Gd0pJi8WjYS60JHOnhIx9R6vktJ3', '358dfiUwFlbFV0Z3KCyvKXwGGxD3']
              || request.auth.uid ==
                 firestore.get(/databases/(default)/documents/reports/$(reportId)).data.reporterId);
      }

      allow read: if isReportParty();
      allow create, update: if isReportParty() && isValidImage();
      allow delete: if isReportParty();
    }

    // ───────────────────────── support images (S113) ─────────────────────────
    //
    // Anexo de foto na thread support/{ticketId}/messages. O path carrega
    // {uid} ANTES de {ticketId} de propósito — deleteAccount varre por
    // prefixo images/support/{uid}/ (functions/src/index.ts), então o dono
    // precisa estar no início do caminho. Autorização espelha o mesmo
    // firestore.get() de images/chats/{matchId}: em vez de checar
    // participante de match, checa dono do ticket (ou admin) — mesma dupla
    // que já pode ler/escrever a subcoleção messages em firestore.rules — e
    // ainda amarra o segmento {uid} do path ao dono real do ticket, pra um
    // upload nunca cair fora do prefixo que o deleteAccount espera.
    match /images/support/{uid}/{ticketId}/{fileName} {
      function isTicketParty() {
        return isSignedIn()
          && (request.auth.uid == uid
              || request.auth.uid in ['Gd0pJi8WjYS60JHOnhIx9R6vktJ3', '358dfiUwFlbFV0Z3KCyvKXwGGxD3'])
          && firestore.get(/databases/(default)/documents/support/$(ticketId)).data.uid == uid;
      }

      allow read: if isTicketParty();
      allow create, update: if isTicketParty() && isValidImage();
      allow delete: if isTicketParty();
    }

    // ───────────────────────── verifications (S20) ─────────────────────────
    //
    // Selfie de verificação de perfil. NUNCA pública: só o dono sobe, só o
    // dono ou o admin leem. S115 — dois uids admin, hardcoded de propósito —
    // Storage Rules não importa src/config/admin.ts, então esta lista precisa
    // ficar em sincronia manual com ADMIN_UIDS no app e com os mesmos
    // literais em firestore.rules.
    match /verifications/{uid}/{fileName} {
      allow read: if isSignedIn()
        && (request.auth.uid == uid
            || request.auth.uid in ['Gd0pJi8WjYS60JHOnhIx9R6vktJ3', '358dfiUwFlbFV0Z3KCyvKXwGGxD3']);
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage();
    }

    // ───────────────────────── deny by default ─────────────────────────
    // Qualquer caminho não listado acima é bloqueado por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
